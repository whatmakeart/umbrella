  function spawnGatePair(wz = 96) {
    const moving = G.level >= 2 && Math.random() < 0.42;
    const makeGate = (wx, forceGood = false) => {
      const r = Math.random();
      if (!forceGood && r < 0.38) {
        return { id: nextId++, wx, baseWx: wx, wz, w: 0.76, op: '+', val: -Math.floor(2 + G.level * 1.4), move: moving ? 0.22 : 0, phase: Math.random() * 6 };
      } else if (r < 0.68) {
        return { id: nextId++, wx, baseWx: wx, wz, w: 0.76, op: '+', val: Math.floor(4 + G.level * 1.8), move: moving ? 0.22 : 0, phase: Math.random() * 6 };
      } else if (r < 0.88) {
        return { id: nextId++, wx, baseWx: wx, wz, w: 0.76, op: 'x', val: 2, move: moving ? 0.18 : 0, phase: Math.random() * 6 };
      } else {
        // Weapon / Power-Up Gate!
        const pId = 1 + Math.floor(Math.random() * 19);
        return { id: nextId++, wx, baseWx: wx, wz, w: 0.76, op: 'pw', val: pId, move: 0, phase: 0 };
      }
    };
    const g1 = makeGate(-0.44);
    const g2 = makeGate(0.44, g1.op === '+' && g1.val < 0);
    G.gates.push(g1, g2);
  }

  function spawnBarricade(wz = 96, wx = null, hpOverride = null, rewardOverride = null) {
    const laneX = wx !== null ? wx : (Math.random() < 0.5 ? -0.42 : 0.42);
    const hp = hpOverride || Math.floor((130 + G.level * 85) * (G.is2P ? 1.4 : 1));
    const reward = rewardOverride !== null ? rewardOverride : (1 + Math.floor(Math.random() * 19));
    G.barricades.push({ id: nextId++, wx: laneX, wz, w: 0.72, hp, maxHp: hp, reward, hitFlash: 0 });
  }

  function spawnBarrel(wz = 88, wx = null) {
    G.barrels.push({
      id: nextId++,
      wx: wx !== null ? wx : (-0.65 + Math.random() * 1.3),
      wz,
      hp: 8 + G.level * 2,
      hitFlash: 0
    });
  }

  function spawnCrate(wz = 92) {
    const pId = 1 + Math.floor(Math.random() * 19);
    const isBombCrate = Math.random() < 0.28;
    G.crates.push({
      id: nextId++,
      wx: -0.6 + Math.random() * 1.2,
      wz,
      hp: 16 + G.level * 6,
      reward: isBombCrate ? 'bomb' : pId,
      hitFlash: 0
    });
  }

  function spawnSawHazard(wz = 96) {
    if (G.level < 2) return;
    G.saws.push({ id: nextId++, wx: (Math.random() - 0.5) * 1.1, wz, vx: (Math.random() < 0.5 ? 1 : -1) * 0.48, rot: 0 });
  }

  function spawnEnemyWave(wz = 96, laneFilter = null) {
    const count = Math.min(20, 6 + G.level * 2);
    for (let i = 0; i < count; i++) {
      let wx = -0.76 + Math.random() * 1.52;
      if (laneFilter === 1) wx = 0.1 + Math.random() * 0.72;
      if (laneFilter === 2) wx = -0.82 + Math.random() * 0.72;
      const isTank = G.level >= 3 && Math.random() < 0.14;
      const hp = Math.ceil((2 + G.level * 1.5) * (isTank ? 4.5 : 1) * (G.is2P && G.mode === 'coop' ? 1.35 : 1));
      G.enemies.push({
        id: nextId++,
        type: isTank ? 'heavy' : 'grunt',
        wx, wz: wz + Math.random() * 15, wy: 0, vy: 0,
        hp, maxHp: hp,
        speed: (isTank ? 10 : 14) + Math.min(11, G.level * 0.7),
        freezeT: 0, hitFlash: 0, phase: Math.random() * 6.28
      });
    }
    if (Math.random() < 0.75) spawnBarrel(wz + 4);
  }

  function spawnLevelBoss() {
    G.bossSpawnedInLevel = true;
    const cfg = getLevelCfg();
    const mult = (1 + (G.level - 1) * 0.42) * (G.is2P && G.mode === 'coop' ? 1.55 : 1);

    if (cfg.boss === 'pair') {
      // Two vanguard titans that COMBINE into GATTAI EMPEROR!
      [-0.44, 0.44].forEach((wx, idx) => {
        const hp = Math.floor(320 * mult);
        G.enemies.push({
          id: nextId++, type: idx === 0 ? 'pairA' : 'pairB',
          wx, wz: 94, wy: 2.0, vy: 0, hp, maxHp: hp,
          speed: 5.5, freezeT: 0, hitFlash: 0, phase: idx * 2, combineReady: true, age: 0
        });
      });
      triggerCutIn('⚠️ TWIN TITANS INCOMING!', 'KILL FAST BEFORE THEY COMBINE!');
    } else if (cfg.boss === 'triTank') {
      // Three cyber-armor drones that COMBINE into COLOSSUS FORTRESS!
      [-0.56, 0, 0.56].forEach((wx, idx) => {
        const hp = Math.floor(240 * mult);
        G.enemies.push({
          id: nextId++, type: 'triUnit',
          wx, wz: 94, wy: 1.5, vy: 0, hp, maxHp: hp,
          speed: 5.0, freezeT: 0, hitFlash: 0, phase: idx, combineReady: true, age: 0
        });
      });
      triggerCutIn('⚠️ TRI-MECH SQUADRON!', 'COMBINATION SEQUENCE IMMINENT!');
    } else {
      const hp = Math.floor(540 * mult);
      G.enemies.push({
        id: nextId++, type: cfg.boss,
        wx: 0, wz: 95, wy: 2.3, vy: 0, hp, maxHp: hp,
        speed: 6.2, freezeT: 0, hitFlash: 0, phase: 0
      });
      const titles = { brawler: 'POMPADOUR BRAWLER!', mech: 'TURBO CYBER MECH!', oni: 'ONI SAMURAI TITAN!' };
      triggerCutIn('⚠️ BOSS: ' + (titles[cfg.boss] || 'TITAN!'), `LEVEL ${G.level} GUARDIAN`);
    }
    SoundFX.boom();
    G.shake = 14;
  }

  function triggerCombine(parts, targetType) {
    G.combiningTimer = 1.45;
    G.combiningTargetType = targetType;
    SoundFX.combine();
    triggerCutIn('⚡ GATTAI COMBINATION!!', targetType === 'gattai' ? 'MEGA GATTAI EMPEROR!' : 'COLOSSUS DREADNOUGHT!');
    G.shake = 18;

    let totalHp = 0;
    let avgZ = 0;
    for (const p of parts) {
      totalHp += Math.max(120, p.hp);
      avgZ += p.wz;
    }
    avgZ = Math.max(38, avgZ / parts.length);

    // Remove parts, spawn combined colossal boss!
    G.enemies = G.enemies.filter(e => !parts.includes(e));
    const bonusHp = Math.floor(totalHp * 1.35 + G.level * 220);
    G.enemies.push({
      id: nextId++,
      type: targetType,
      wx: 0,
      wz: avgZ,
      wy: 1.4,
      vy: 0,
      hp: bonusHp,
      maxHp: bonusHp,
      speed: 4.5,
      freezeT: 0,
      hitFlash: 0.3,
      phase: 0
    });
    G.shockwaves.push({ wx: 0, wz: avgZ, r: 0.1, maxR: 2.2, color: '#ffd43b', life: 0.65 });
    addParticles(0, 0.5, avgZ, '#ffd43b', 35, 2.2);
  }

  // =========================================================================
  // 6. DOUBLE-TAP BOMBS, BARRELS, POWERUP APPLICATION
  // =========================================================================
  function grantPowerUp(pid, pId) {
    const p = G.players[pid];
    const pu = POWERUPS[pId];
    if (!p || !pu) return;
    if (pu.kind === 'wep') {
      p.wep = pu.id;
      p.wepTimer = 16;
      addPopup(p.x, 0.52, 2, `${pu.icon} ${pu.name}!`, pu.color, 21);
    } else {
      p.buffs[pu.key] = 22;
      addPopup(p.x, 0.52, 2, `${pu.icon} ${pu.name}!`, pu.color, 20);
    }
    p.ult = Math.min(100, p.ult + 16);
    SoundFX.powerup();
  }

  function dropBombStrike(pid, wx, wz) {
    const p = G.players[pid];
    if (!p || p.bombs <= 0 || p.downed > 0) return;
    p.bombs--;
    G.bombStrikes.push({ owner: pid, wx, wz, timer: 0.42, maxT: 0.42 });
    SoundFX.nuke();
    addPopup(wx, 0.45, wz, '💣 AIRSTRIKE!', '#ffd43b', 22);
  }

  function detonateExplosion(wx, wz, radius = 0.85, zRange = 14, dmg = 95, owner = 1) {
    G.shake = Math.max(G.shake, 18);
    G.flash = 0.35;
    G.hitstop = 0.055;
    SoundFX.boom();
    G.shockwaves.push({ wx, wz, r: 0.1, maxR: radius * 1.4, color: '#ff922b', life: 0.45 });
    addParticles(wx, 0.3, wz, '#ff6b35', 28, 2.1);
    addParticles(wx, 0.5, wz, '#ffd43b', 16, 1.8);

    for (let i = G.enemies.length - 1; i >= 0; i--) {
      const e = G.enemies[i];
      if (Math.abs(e.wx - wx) < radius + (e.type === 'boss' || e.type === 'gattai' ? 0.35 : 0.15) && Math.abs(e.wz - wz) < zRange) {
        e.hp -= dmg;
        e.hitFlash = 0.16;
        if (e.hp <= 0) handleEnemyKill(e, i, owner);
      }
    }
    for (let k = G.barricades.length - 1; k >= 0; k--) {
      const b = G.barricades[k];
      if (Math.abs(b.wx - wx) < radius + 0.35 && Math.abs(b.wz - wz) < zRange) {
        b.hp -= dmg * 1.2;
        if (b.hp <= 0) destroyBarricade(b, k, owner);
      }
    }
  }

  function destroyBarricade(bar, idx, ownerId) {
    grantPowerUp(ownerId, bar.reward);
    addParticles(bar.wx, 0.3, bar.wz, '#ff9900', 18, 1.5);
    G.shake = Math.max(G.shake, 8);
    G.score += 60;
    G.barricades.splice(idx, 1);
  }

  function handleEnemyKill(e, idx, ownerId) {
    const isBoss = ['brawler', 'mech', 'oni', 'pairA', 'pairB', 'triUnit', 'gattai', 'fortress'].includes(e.type);
    const isMega = e.type === 'gattai' || e.type === 'fortress';
    spawnRagdoll(e.wx, e.wz, isBoss);
    addParticles(e.wx, 0.25, e.wz, isBoss ? '#ff9900' : '#ff2e2e', isBoss ? 32 : 8, isBoss ? 2.1 : 1.0);
    G.kills++;
    G.combo = Math.min(30, G.combo + (isBoss ? 5 : 1));
    G.comboTimer = 2.8;
    const owner = G.players[ownerId];
    const magMult = owner && owner.buffs.magnet > 0 ? 2 : 1;
    const pts = (isMega ? 600 : isBoss ? 300 : 12) * G.combo * magMult;
    G.score += pts;

    // Coin drops
    if (Math.random() < (isBoss ? 1 : 0.35)) {
      const nCoins = isBoss ? 8 : 1;
      for (let c = 0; c < nCoins; c++) {
        G.coins.push({ id: nextId++, wx: e.wx + (Math.random() - 0.5) * 0.35, wz: e.wz + (Math.random() - 0.5) * 3 });
      }
    }

    if (owner) {
      owner.ult = Math.min(100, owner.ult + (isBoss ? 38 : 3.2));
      if (owner.buffs.vamp > 0) {
        owner.killCounter++;
        if (owner.killCounter % 7 === 0) {
          owner.count++;
          addPopup(owner.x, 0.4, 2, '🦇 +1 TROOP', '#e64980', 16);
        }
      }
    }

    G.enemies.splice(idx, 1);

    if (isBoss) {
      G.shake = 18;
      G.hitstop = 0.08;
      SoundFX.boom();
      addPopup(e.wx, 0.55, e.wz, `BOSS CRUSHED! +${pts}`, '#ffd43b', 24);
      if (G.is2P && G.mode === 'vs') {
        spawnEnemyWave(88, ownerId === 1 ? 2 : 1);
      }
      // Check if all bosses in this level are dead -> LEVEL CLEAR!
      const remBoss = G.enemies.some(o => ['brawler', 'mech', 'oni', 'pairA', 'pairB', 'triUnit', 'gattai', 'fortress'].includes(o.type));
      if (!remBoss && G.bossSpawnedInLevel) {
        advanceLevel();
      }
    }
  }

  function advanceLevel() {
    G.level++;
    G.dist = 0;
    G.bossSpawnedInLevel = false;
    SoundFX.levelClear();
    [1, 2].forEach(pid => {
      if (pid === 2 && !G.is2P) return;
      G.players[pid].bombs = Math.min(9, G.players[pid].bombs + 1);
    });
    const cfg = getLevelCfg();
    triggerCutIn(`🌟 LEVEL ${G.level}: ${cfg.name.toUpperCase()}`, '+1 TACTICAL BOMB AWARDED!');
    initDeco();
  }

  // =========================================================================
  // 7. HELPERS FOR FX & CUT-IN
  // =========================================================================
  function addPopup(wx, wy, wz, text, color = '#fff', size = 18) {
    if (G.popups.length > 42) G.popups.shift();
    G.popups.push({ wx, wy, wz, text, color, size, life: 0.85, maxLife: 0.85 });
  }

  function addParticles(wx, wy, wz, color, count = 8, speed = 1) {
    for (let i = 0; i < count; i++) {
      if (G.particles.length > 200) G.particles.shift();
      G.particles.push({
        wx, wy, wz,
        vx: (Math.random() - 0.5) * 2.2 * speed,
        vy: (0.4 + Math.random() * 1.4) * speed,
        vz: (Math.random() - 0.5) * 16 * speed,
        color, size: 3 + Math.random() * 5, life: 0.45 + Math.random() * 0.35
      });
    }
  }

  function spawnRagdoll(wx, wz, isBoss = false) {
    if (G.ragdolls.length > 60) G.ragdolls.shift();
    const dir = wx >= 0 ? 1 : -1;
    G.ragdolls.push({
      wx, wy: 0.1, wz,
      vx: dir * (1.2 + Math.random() * 2.2) + (Math.random() - 0.5) * 1.4,
      vy: (isBoss ? 3.8 : 1.7) + Math.random() * 1.8,
      vz: 12 + Math.random() * 18,
      rot: 0, vrot: (Math.random() - 0.5) * 18,
      isBoss, splashed: false, life: 1.6
    });
  }

  let cutInTimeout = null;
  function triggerCutIn(title, sub = 'ANIME OVERDRIVE') {
    const el = document.getElementById('cutIn');
    document.getElementById('cutInTitle').textContent = title;
    document.getElementById('cutInSub').textContent = sub;
    el.classList.add('active');
    G.speedLines = 1.4;
    clearTimeout(cutInTimeout);
    cutInTimeout = setTimeout(() => el.classList.remove('active'), 1450);
  }

  function activateUlt(pid) {
    const p = G.players[pid];
    if (!p || p.ult < 100 || p.downed > 0) return;
    p.ult = 0;
    p.ultActive = 4.8;
    SoundFX.ult();
    G.shake = 16;
    G.hitstop = 0.06;
    const other = G.players[pid === 1 ? 2 : 1];
    if (G.is2P && G.mode === 'coop' && other && other.ultActive > 1.5) {
      triggerCutIn('🌟 UNISON ORBITAL CANNON!!', 'P1 + P2 HYPER COMBO');
      detonateExplosion(0, 38, 1.5, 45, 220, pid);
    } else {
      triggerCutIn(pid === 1 ? '🔵 MAXIMUM OVERDRIVE!!' : '💖 SAKURA HYPER BEAM!!', `PLAYER ${pid} FEVER`);
    }
  }

  // =========================================================================
  // 8. SIMULATION UPDATE
  // =========================================================================
  function updateSimulation(dt) {
    if (!G.running) return;
    if (G.hitstop > 0) { G.hitstop -= dt; return; }

    const feverMult = G.combo >= 15 ? 1.25 : 1.0;
    G.scroll += dt * 30 * feverMult;
    if (!G.bossSpawnedInLevel) G.dist += dt * 16;
    if (G.shake > 0) G.shake = Math.max(0, G.shake - dt * 34);
    if (G.flash > 0) G.flash = Math.max(0, G.flash - dt * 1.8);
    if (G.speedLines > 0) G.speedLines = Math.max(0, G.speedLines - dt);
    if (G.combiningTimer > 0) G.combiningTimer = Math.max(0, G.combiningTimer - dt);
    if (G.comboTimer > 0) {
      G.comboTimer -= dt;
      if (G.comboTimer <= 0) G.combo = 1;
    }

    for (const d of G.hordeDeco) {
      d.wz -= dt * 15; d.phase += dt * 9;
      if (d.wz < -2) d.wz = 96;
    }

    const isClient = G.is2P && G.myId === 2;

    // Players movement, buffs, firing, autonomous drones
    [1, 2].forEach(pid => {
      if (pid === 2 && !G.is2P) return;
      const p = G.players[pid];
      const minX = (G.mode === 'vs' && pid === 1) ? 0.14 : -0.78;
      const maxX = (G.mode === 'vs' && pid === 2) ? -0.14 : 0.78;
      p.targetX = Math.max(minX, Math.min(maxX, p.targetX));
      p.x += (p.targetX - p.x) * Math.min(1, dt * 16);

      if (p.tauntT > 0) p.tauntT -= dt;
      if (p.ultActive > 0) p.ultActive = Math.max(0, p.ultActive - dt);
      if (p.wepTimer > 0) {
        p.wepTimer -= dt;
        if (p.wepTimer <= 0) p.wep = 0;
      }
      for (const k of Object.keys(p.buffs)) {
        if (p.buffs[k] > 0) p.buffs[k] = Math.max(0, p.buffs[k] - dt);
      }

      if (p.downed > 0 && !isClient) {
        p.downed -= dt;
        if (p.downed <= 0) { p.count = 4; addPopup(p.x, 0.35, 2, 'REVIVED!', '#69db7c', 20); }
      }

      if (p.count > 0 && p.downed <= 0) {
        const w = POWERUPS[p.wep] || POWERUPS[0];
        const rate = (p.ultActive > 0 ? w.rate * 0.42 : w.rate) / feverMult;
        p.fireAcc += dt;
        if (p.fireAcc >= rate) {
          p.fireAcc = 0;
          const baseStreams = Math.min(6, 1 + Math.floor(Math.sqrt(p.count) * 0.7)) + (p.ultActive > 0 ? 2 : 0);
          const pellets = w.pellets ? w.pellets : baseStreams;
          const dmgTotal = w.dmg * (1 + p.count * 0.085) * (p.ultActive > 0 ? 2.1 : 1) * (p.buffs.acid > 0 ? 1.5 : 1);
          const dmgPer = dmgTotal / pellets;

          for (let s = 0; s < pellets; s++) {
            if (G.bullets.length > 190) break;
            const offX = w.pellets ? 0 : (s - (pellets - 1) / 2) * 0.085;
            const angleSpread = (Math.random() - 0.5) * w.spread + (w.pellets ? (s - (pellets - 1) / 2) * 0.032 : 0);
            G.bullets.push({
              owner: pid,
              wep: p.ultActive > 0 ? 1 : p.wep,
              wx: p.x + offX, wy: 0.16, wz: 2.2,
              vx: angleSpread,
              vz: w.speed,
              dmg: dmgPer,
              pierce: (p.ultActive > 0 ? 4 : w.pierce) || 1,
              acid: p.buffs.acid > 0,
              shock: p.buffs.shock > 0,
              life: w.range ? 0.75 : 2.2,
              ret: false
            });
          }
          if (G.casings.length < 65 && p.wep !== 4 && p.wep !== 8) {
            G.casings.push({ wx: p.x + 0.12, wy: 0.18, wz: 2.0, vx: 0.5 + Math.random() * 0.8, vy: 0.9 + Math.random() * 0.5, vz: (Math.random() - 0.5) * 4, life: 0.5 });
          }
          if (pid === G.myId) SoundFX.shoot(p.ultActive > 0 ? 1 : p.wep);
        }

        // Autonomous Drone Squad fire!
        if (p.buffs.drones > 0) {
          p.droneAcc += dt;
          if (p.droneAcc >= 0.16) {
            p.droneAcc = 0;
            [-0.25, 0.25].forEach(dx => {
              G.bullets.push({ owner: pid, wep: 3, wx: p.x + dx, wy: 0.34, wz: 2.2, vx: 0, vz: 115, dmg: 1.5 + p.count * 0.05, pierce: 2, life: 1.5, ret: false });
            });
          }
        }
      }
    });

    // Update Bullets
    for (let i = G.bullets.length - 1; i >= 0; i--) {
      const b = G.bullets[i];
      const pu = POWERUPS[b.wep] || POWERUPS[0];
      b.life -= dt;

      // Special bullet trajectories
      if (pu.homing && G.enemies.length > 0 && !isClient) {
        let best = null, bestD = 999;
        for (const e of G.enemies) {
          if (e.wz > b.wz) {
            const d = Math.hypot(e.wx - b.wx, (e.wz - b.wz) * 0.08);
            if (d < bestD) { bestD = d; best = e; }
          }
        }
        if (best) b.vx += Math.sign(best.wx - b.wx) * dt * 0.85;
      }
      if (pu.ricochet && Math.abs(b.wx) > 0.85) b.vx = -b.vx;
      if (pu.boomerang && !b.ret && b.wz > 54) { b.vz = -b.vz * 0.85; b.ret = true; }

      b.wx += b.vx * dt * 12;
      b.wz += b.vz * dt;

      // Black Hole pull!
      if (pu.vortex && !isClient) {
        for (const e of G.enemies) {
          if (Math.abs(e.wz - b.wz) < 12 && Math.abs(e.wx - b.wx) < 0.75) {
            e.wx += (b.wx - e.wx) * dt * 4.5;
            e.wz += (b.wz - e.wz) * dt * 4.5;
          }
        }
      }

      if (b.life <= 0 || b.wz > 105 || b.wz < -2) { G.bullets.splice(i, 1); continue; }
      if (isClient) continue;

      let consumed = false;

      // vs Gates
      for (let gIdx = G.gates.length - 1; gIdx >= 0; gIdx--) {
        const g = G.gates[gIdx];
        if ((g.op === '+' || g.op === 'x') && Math.abs(b.wz - g.wz) < 2.6 && Math.abs(b.wx - g.wx) < g.w * 0.52) {
          g.hits++;
          if (g.op === '+') { g.val += 1; if (g.val === 0) g.val = 1; }
          else if (g.op === 'x' && g.hits % 14 === 0 && g.val < 6) g.val += 1;
          addParticles(b.wx, 0.25, g.wz, g.val >= 0 ? '#22e58a' : '#ff4b4b', 2, 0.6);
          if (g.hits % 4 === 0) SoundFX.gateUp();
          consumed = true; break;
        }
      }
      if (consumed) { G.bullets.splice(i, 1); continue; }

      // vs Barrels (Explosive!)
      for (let brIdx = G.barrels.length - 1; brIdx >= 0; brIdx--) {
        const br = G.barrels[brIdx];
        if (Math.abs(b.wz - br.wz) < 2.4 && Math.abs(b.wx - br.wx) < 0.18) {
          br.hp -= b.dmg; br.hitFlash = 0.08;
          if (br.hp <= 0) {
            G.barrels.splice(brIdx, 1);
            detonateExplosion(br.wx, br.wz, 0.75, 13, 65 + G.level * 15, b.owner);
          }
          b.pierce--; if (b.pierce <= 0) { consumed = true; break; }
        }
      }
      if (consumed) { G.bullets.splice(i, 1); continue; }

      // vs Mystery ? Crates
      for (let crIdx = G.crates.length - 1; crIdx >= 0; crIdx--) {
        const cr = G.crates[crIdx];
        if (Math.abs(b.wz - cr.wz) < 2.5 && Math.abs(b.wx - cr.wx) < 0.22) {
          cr.hp -= b.dmg; cr.hitFlash = 0.08;
          if (cr.hp <= 0) {
            if (cr.reward === 'bomb') {
              G.players[b.owner].bombs = Math.min(9, G.players[b.owner].bombs + 1);
              addPopup(cr.wx, 0.45, cr.wz, '💣 +1 BOMB!', '#ffd43b', 20);
              SoundFX.powerup();
            } else {
              grantPowerUp(b.owner, cr.reward);
            }
            addParticles(cr.wx, 0.3, cr.wz, '#ffd43b', 14, 1.4);
            G.crates.splice(crIdx, 1);
          }
          b.pierce--; if (b.pierce <= 0) { consumed = true; break; }
        }
      }
      if (consumed) { G.bullets.splice(i, 1); continue; }

      // vs Tire Barricades
      for (let k = G.barricades.length - 1; k >= 0; k--) {
        const bar = G.barricades[k];
        if (Math.abs(b.wz - bar.wz) < 3.0 && Math.abs(b.wx - bar.wx) < bar.w * 0.55) {
          bar.hp -= b.dmg * (b.acid ? 1.8 : 1);
          bar.hitFlash = 0.08;
          addParticles(b.wx, 0.22, bar.wz, '#ffd43b', 2, 0.7);
          if (bar.hp <= 0) destroyBarricade(bar, k, b.owner);
          b.pierce--; if (b.pierce <= 0) { consumed = true; break; }
        }
      }
      if (consumed) { G.bullets.splice(i, 1); continue; }

      // vs Enemies
      for (let eIdx = G.enemies.length - 1; eIdx >= 0; eIdx--) {
        const e = G.enemies[eIdx];
        const isMega = e.type === 'gattai' || e.type === 'fortress';
        const isBoss = isMega || ['brawler', 'mech', 'oni', 'pairA', 'pairB', 'triUnit'].includes(e.type);
        const hitR = isMega ? 0.52 : isBoss ? 0.36 : 0.17;
        if (Math.abs(b.wz - e.wz) < (isBoss ? 4.4 : 2.6) && Math.abs(b.wx - e.wx) < hitR) {
          e.hp -= b.dmg * (b.acid ? 1.5 : 1);
          e.hitFlash = 0.09;
          if (pu.freeze) e.freezeT = 2.4;
          if (pu.knock || b.shock) e.wz = Math.min(95, e.wz + (pu.knock || 1.2));
          addParticles(b.wx, 0.2, e.wz, pu.color, 3, 0.7);

          // Rocket / Cluster AoE
          if (pu.aoe || pu.cluster) {
            addParticles(b.wx, 0.25, b.wz, '#ff9900', 10, 1.3);
            for (const o of G.enemies) {
              if (o !== e && Math.abs(o.wz - e.wz) < 8 && Math.abs(o.wx - e.wx) < 0.5) o.hp -= b.dmg * 0.75;
            }
          }
          // Chain Lightning arcs!
          if (pu.chain) {
            let prev = e, jumps = pu.chain;
            for (const o of G.enemies) {
              if (jumps <= 0) break;
              if (o !== prev && Math.abs(o.wz - prev.wz) < 16 && Math.abs(o.wx - prev.wx) < 0.8) {
                o.hp -= b.dmg * 0.65; o.hitFlash = 0.09;
                G.lightningArcs.push({ x1: prev.wx, z1: prev.wz, x2: o.wx, z2: o.wz, life: 0.14 });
                prev = o; jumps--;
              }
            }
          }

          if (e.hp <= 0) handleEnemyKill(e, eIdx, b.owner);
          b.pierce--; if (b.pierce <= 0) { consumed = true; break; }
        }
      }
      if (consumed) G.bullets.splice(i, 1);
    }

    // Host Spawns & World Progression
    if (!isClient) {
      const lvlCfg = getLevelCfg();
      if (!G.bossSpawnedInLevel && G.dist >= lvlCfg.len) {
        spawnLevelBoss();
      }

      G.gateTimer -= dt;
      if (G.gateTimer <= 0) {
        G.gateTimer = 4.3;
        spawnGatePair(98);
        if (Math.random() < 0.65) spawnBarricade(85);
        if (Math.random() < 0.5) spawnCrate(90);
        if (Math.random() < 0.35) spawnSawHazard(96);
      }

      G.spawnTimer -= dt;
      if (G.spawnTimer <= 0) {
        G.spawnTimer = Math.max(1.4, 2.8 - G.level * 0.1);
        spawnEnemyWave(96);
      }

      // Check Boss Combiner Triggers!
      const pairParts = G.enemies.filter(e => e.type === 'pairA' || e.type === 'pairB');
      if (pairParts.length === 2 && (pairParts.some(p => p.age > 5.5) || pairParts.some(p => p.hp < p.maxHp * 0.55))) {
        triggerCombine(pairParts, 'gattai');
      }
      const triParts = G.enemies.filter(e => e.type === 'triUnit');
      if (triParts.length >= 2 && (triParts.some(p => p.age > 5.2) || triParts.some(p => p.hp < p.maxHp * 0.6))) {
        triggerCombine(triParts, 'fortress');
      }

      // Bomb Strikes countdown
      for (let i = G.bombStrikes.length - 1; i >= 0; i--) {
        const bs = G.bombStrikes[i];
        bs.timer -= dt;
        if (bs.timer <= 0) {
          detonateExplosion(bs.wx, bs.wz, 1.05, 18, 160 + G.level * 45, bs.owner);
          G.bombStrikes.splice(i, 1);
        }
      }

      // Move Gates
      for (let i = G.gates.length - 1; i >= 0; i--) {
        const g = G.gates[i];
        g.wz -= dt * 21;
        if (g.move > 0) { g.phase += dt * 2.5; g.wx = g.baseWx + Math.sin(g.phase) * g.move; }
        if (g.wz <= 2.4 && g.wz >= -0.5) {
          let hit = false;
          [1, 2].forEach(pid => {
            if (pid === 2 && !G.is2P) return;
            const p = G.players[pid];
            if (p.downed <= 0 && Math.abs(p.x - g.wx) < g.w * 0.54) {
              hit = true;
              if (g.op === 'pw') {
                grantPowerUp(pid, g.val);
              } else {
                const prev = p.count;
                if (g.op === '+') p.count = Math.max(0, p.count + g.val);
                else if (g.op === 'x') p.count = Math.min(999, p.count * g.val);
                const diff = p.count - prev;
                p.ult = Math.min(100, p.ult + 12);
                addPopup(p.x, 0.45, 2, (diff >= 0 ? '+' : '') + diff + ' TROOPS', diff >= 0 ? '#22e58a' : '#ff3b3b', 20);
                if (diff >= 0) SoundFX.gateGood(); else SoundFX.gateBad();
              }
            }
          });
          if (hit) { G.gates.splice(i, 1); continue; }
        }
        if (g.wz < -2) G.gates.splice(i, 1);
      }

      // Move Barricades, Barrels, Crates, Saws, Coins
      for (let i = G.barricades.length - 1; i >= 0; i--) {
        const bar = G.barricades[i];
        bar.wz -= dt * 21;
        if (bar.hitFlash > 0) bar.hitFlash -= dt;
        if (bar.wz <= 2.2 && bar.wz >= -0.5) {
          [1, 2].forEach(pid => {
            if (pid === 2 && !G.is2P) return;
            const p = G.players[pid];
            if (p.downed <= 0 && Math.abs(p.x - bar.wx) < bar.w * 0.52) {
              if (p.buffs.shield > 0) {
                p.buffs.shield = 0;
                addPopup(p.x, 0.45, 2, '🛡️ SHIELD BLOCK!', '#4dabf7', 20);
              } else {
                const loss = Math.max(2, Math.ceil(p.count * 0.35));
                p.count = Math.max(0, p.count - loss);
                addPopup(p.x, 0.4, 2, `-${loss} CRASH!`, '#ff4b4b', 20);
              }
              G.shake = 12; SoundFX.boom(); G.barricades.splice(i, 1);
            }
          });
        } else if (bar.wz < -2) G.barricades.splice(i, 1);
      }

      for (let i = G.barrels.length - 1; i >= 0; i--) {
        const br = G.barrels[i]; br.wz -= dt * 21;
        if (br.hitFlash > 0) br.hitFlash -= dt;
        if (br.wz < -2) G.barrels.splice(i, 1);
      }

      for (let i = G.crates.length - 1; i >= 0; i--) {
        const cr = G.crates[i]; cr.wz -= dt * 21;
        if (cr.hitFlash > 0) cr.hitFlash -= dt;
        if (cr.wz < -2) G.crates.splice(i, 1);
      }

      for (let i = G.saws.length - 1; i >= 0; i--) {
        const sw = G.saws[i];
        sw.wz -= dt * 22; sw.wx += sw.vx * dt; sw.rot += dt * 14;
        if (Math.abs(sw.wx) > 0.78) sw.vx = -sw.vx;
        if (sw.wz <= 2.3 && sw.wz >= 0.4) {
          [1, 2].forEach(pid => {
            if (pid === 2 && !G.is2P) return;
            const p = G.players[pid];
            if (p.downed <= 0 && Math.abs(p.x - sw.wx) < 0.25) {
              if (p.buffs.shield > 0) { p.buffs.shield = 0; addPopup(p.x, 0.4, 2, '🛡️ BLOCKED SAW!', '#4dabf7', 18); }
              else { p.count = Math.max(0, p.count - 3); addPopup(p.x, 0.4, 2, '-3 SAW!', '#ff3b3b', 18); }
              G.saws.splice(i, 1);
            }
          });
        } else if (sw.wz < -2) G.saws.splice(i, 1);
      }

      for (let i = G.coins.length - 1; i >= 0; i--) {
        const c = G.coins[i]; c.wz -= dt * 21;
        let grabbed = false;
        [1, 2].forEach(pid => {
          if (pid === 2 && !G.is2P) return;
          const p = G.players[pid];
          const pullR = p.buffs.magnet > 0 ? 0.95 : 0.34;
          if (p.buffs.magnet > 0 && c.wz < 24) {
            c.wx += (p.x - c.wx) * dt * 6;
          }
          if (c.wz <= 3.0 && Math.abs(p.x - c.wx) < pullR) {
            G.score += 25 * G.combo;
            p.ult = Math.min(100, p.ult + 2.5);
            SoundFX.coin();
            grabbed = true;
          }
        });
        if (grabbed || c.wz < -2) G.coins.splice(i, 1);
      }

      // Move Enemies
      for (let i = G.enemies.length - 1; i >= 0; i--) {
        const e = G.enemies[i];
        e.age = (e.age || 0) + dt;
        if (e.freezeT > 0) e.freezeT -= dt;
        const spd = e.speed * (e.freezeT > 0 ? 0.4 : 1);
        e.wz -= dt * spd;
        e.phase += dt * 11;
        if (e.hitFlash > 0) e.hitFlash -= dt;
        if (e.wy > 0) {
          e.vy -= dt * 9.5;
          e.wy = Math.max(0, e.wy + e.vy * dt);
          if (e.wy === 0) G.shake = 10;
        }
        if (e.wz <= 2.4) {
          const isBoss = ['brawler', 'mech', 'oni', 'pairA', 'pairB', 'triUnit', 'gattai', 'fortress'].includes(e.type);
          let hit = false;
          [1, 2].forEach(pid => {
            if (pid === 2 && !G.is2P) return;
            const p = G.players[pid];
            if (p.downed <= 0 && Math.abs(p.x - e.wx) < (isBoss ? 0.6 : 0.32)) {
              if (p.buffs.shield > 0) {
                p.buffs.shield = 0;
                addPopup(p.x, 0.4, 2, '🛡️ SHIELD!', '#4dabf7', 18);
              } else {
                const dmg = isBoss ? Math.max(6, Math.ceil(p.count * 0.55)) : (e.type === 'heavy' ? 3 : 1);
                p.count = Math.max(0, p.count - dmg);
              }
              G.shake = Math.max(G.shake, isBoss ? 16 : 6);
              addParticles(p.x, 0.2, 2, '#ff3b3b', 6, 1);
              hit = true;
            }
          });
          if (hit || e.wz < -1) {
            G.enemies.splice(i, 1);
            if (isBoss && G.bossSpawnedInLevel) {
              const remBoss = G.enemies.some(o => ['brawler', 'mech', 'oni', 'pairA', 'pairB', 'triUnit', 'gattai', 'fortress'].includes(o.type));
              if (!remBoss) advanceLevel();
            }
          }
        }
      }

      // Downed / Game Over
      [1, 2].forEach(pid => {
        if (pid === 2 && !G.is2P) return;
        const p = G.players[pid];
        if (p.count <= 0 && p.downed <= 0 && G.is2P && G.mode === 'coop') {
          const other = G.players[pid === 1 ? 2 : 1];
          if (other.count > 0 && other.downed <= 0) {
            p.downed = 6.0;
            addPopup(p.x, 0.4, 2, 'DOWNED! REVIVE 6s', '#ffd43b', 18);
          }
        }
      });
      if (G.players[1].count <= 0 && (!G.is2P || G.players[2].count <= 0)) triggerGameOver();
    }

    // Local Particle / Ragdoll / Shockwave Updates
    for (let i = G.shockwaves.length - 1; i >= 0; i--) {
      const s = G.shockwaves[i]; s.life -= dt; s.r += (s.maxR - s.r) * dt * 10;
      if (s.life <= 0) G.shockwaves.splice(i, 1);
    }
    for (let i = G.lightningArcs.length - 1; i >= 0; i--) {
      G.lightningArcs[i].life -= dt;
      if (G.lightningArcs[i].life <= 0) G.lightningArcs.splice(i, 1);
    }
    for (let i = G.ragdolls.length - 1; i >= 0; i--) {
      const r = G.ragdolls[i];
      r.wx += r.vx * dt; r.wy += r.vy * dt; r.wz += r.vz * dt; r.vy -= dt * 9.8; r.rot += r.vrot * dt;
      if (r.wy < 0 && Math.abs(r.wx) < 0.92) { r.wy = 0; r.vy = Math.abs(r.vy) * 0.45; }
      else if (r.wy < -0.25 && !r.splashed) { r.splashed = true; addParticles(r.wx, -0.2, r.wz, '#74c0fc', 7, 1.1); }
      r.life -= dt;
      if (r.life <= 0) G.ragdolls.splice(i, 1);
    }
    for (let i = G.particles.length - 1; i >= 0; i--) {
      const p = G.particles[i];
      p.wx += p.vx * dt; p.wy += p.vy * dt; p.wz += p.vz * dt; p.vy -= dt * 4.5; p.life -= dt;
      if (p.life <= 0) G.particles.splice(i, 1);
    }
    for (let i = G.casings.length - 1; i >= 0; i--) {
      const c = G.casings[i];
      c.wx += c.vx * dt; c.wy += c.vy * dt; c.wz += c.vz * dt; c.vy -= dt * 7.5;
      if (c.wy < 0) { c.wy = 0; c.vy = Math.abs(c.vy) * 0.4; }
      c.life -= dt;
      if (c.life <= 0) G.casings.splice(i, 1);
    }
    for (let i = G.popups.length - 1; i >= 0; i--) {
      const pop = G.popups[i]; pop.wy += dt * 0.55; pop.life -= dt;
      if (pop.life <= 0) G.popups.splice(i, 1);
    }

    // Weather particles
    for (const w of G.weather) {
      w.y += w.vy * dt; w.x += w.vx * dt;
      if (w.y > H) { w.y = -10; w.x = Math.random() * W; }
      if (w.x < 0) w.x = W; if (w.x > W) w.x = 0;
    }

    // Network Sync
    if (G.is2P && Net.isConnected()) {
      const now = performance.now();
      if (G.myId === 1 && now - lastNetSend > 45) {
        lastNetSend = now;
        Net.send({
          t: 'state',
          lv: G.level, ds: G.dist, s: G.score, k: G.kills, c: G.combo, bs: G.bossSpawnedInLevel,
          p1: { x: G.players[1].x, n: G.players[1].count, wp: G.players[1].wep, u: G.players[1].ult, ua: G.players[1].ultActive, dn: G.players[1].downed, bm: G.players[1].bombs, bf: G.players[1].buffs },
          p2: { x: G.players[2].x, n: G.players[2].count, wp: G.players[2].wep, u: G.players[2].ult, ua: G.players[2].ultActive, dn: G.players[2].downed, bm: G.players[2].bombs, bf: G.players[2].buffs },
          gt: G.gates.map(g => ({ id: g.id, x: g.wx, z: g.wz, w: g.w, op: g.op, v: g.val })),
          br: G.barricades.map(b => ({ id: b.id, x: b.wx, z: b.wz, w: b.w, hp: b.hp, m: b.maxHp, r: b.reward })),
          bl: G.barrels.map(b => ({ id: b.id, x: b.wx, z: b.wz })),
          cr: G.crates.map(c => ({ id: c.id, x: c.wx, z: c.wz, r: c.reward })),
          sw: G.saws.map(s => ({ id: s.id, x: s.wx, z: s.wz, r: s.rot })),
          cn: G.coins.slice(0, 20).map(c => ({ id: c.id, x: c.wx, z: c.wz })),
          bmS: G.bombStrikes.map(b => ({ x: b.wx, z: b.wz, t: b.timer, m: b.maxT })),
          en: G.enemies.slice(0, 48).map(e => ({ id: e.id, tp: e.type, x: e.wx, y: e.wy, z: e.wz, hp: e.hp, m: e.maxHp, f: e.freezeT }))
        });
      } else if (G.myId === 2 && now - lastNetSend > 33) {
        lastNetSend = now;
        Net.send({ t: 'input', tx: G.players[2].targetX });
      }
    }

    updateHUD();
  }

  function triggerGameOver() {
    G.running = false;
    if (G.is2P && G.myId === 1) Net.send({ t: 'gameover', s: G.score, k: G.kills, w: G.level });
    showGameOverUI(G.score, G.kills, G.level);
  }

  function showGameOverUI(score, kills, lvl) {
    document.getElementById('hud').style.display = 'none';
    document.getElementById('modal').classList.remove('hidden');
    document.getElementById('lobbyView').style.display = 'none';
    document.getElementById('hostView').style.display = 'none';
    document.getElementById('gameOverView').style.display = 'block';
    document.getElementById('goScore').textContent = score.toLocaleString();
    document.getElementById('goKills').textContent = kills;
    document.getElementById('goWave').textContent = lvl;
  }

  function updateHUD() {
    const p1 = G.players[1], p2 = G.players[2], me = G.players[G.myId];
    const cfg = getLevelCfg();
    document.getElementById('hudP1Count').textContent = p1.downed > 0 ? 'SOS' : p1.count;
    document.getElementById('hudP1Wep').textContent = POWERUPS[p1.wep].icon + ' ' + POWERUPS[p1.wep].name;
    document.getElementById('hudP2Count').textContent = p2.downed > 0 ? 'SOS' : p2.count;
    document.getElementById('hudP2Wep').textContent = POWERUPS[p2.wep].icon + ' ' + POWERUPS[p2.wep].name;
    document.getElementById('hudLvlName').textContent = `LVL ${G.level} • ${cfg.name.toUpperCase()}`;
    document.getElementById('hudCombo').textContent = G.combo >= 15 ? `🔥FEVER x${G.combo}` : `x${G.combo}`;
    document.getElementById('hudScore').textContent = G.score.toLocaleString();
    document.getElementById('hudBombs').textContent = me.bombs;

    const pctDist = G.bossSpawnedInLevel ? 100 : Math.min(100, Math.floor((G.dist / cfg.len) * 100));
    document.getElementById('hudDistText').textContent = pctDist + '%';
    document.getElementById('hudLvlFill').style.width = pctDist + '%';

    // Active passive buffs strip
    const buffStrip = document.getElementById('buffStrip');
    const chips = [];
    for (let id = 14; id <= 19; id++) {
      const pu = POWERUPS[id];
      if (me.buffs[pu.key] > 0) chips.push(`<span class="buff-chip">${pu.icon} ${Math.ceil(me.buffs[pu.key])}s</span>`);
    }
    buffStrip.innerHTML = chips.join('');

    const pctUlt = Math.floor(me.ult);
    document.getElementById('ultChargeText').textContent = me.ultActive > 0 ? '🔥 ACTIVE!' : `ULT ${pctUlt}%`;
    const btnUlt = document.getElementById('btnUlt');
    if (pctUlt >= 100 && me.downed <= 0) btnUlt.classList.add('ready'); else btnUlt.classList.remove('ready');

    const bosses = G.enemies.filter(e => ['brawler', 'mech', 'oni', 'pairA', 'pairB', 'triUnit', 'gattai', 'fortress'].includes(e.type));
    const bw = document.getElementById('bossBarWrap');
    if (bosses.length > 0) {
      let hp = 0, maxHp = 0;
      bosses.forEach(b => { hp += Math.max(0, b.hp); maxHp += b.maxHp; });
      bw.style.display = 'block';
      document.getElementById('bossBarFill').style.width = Math.max(0, (hp / Math.max(1, maxHp)) * 100) + '%';
      const b0 = bosses[0];
      const nameMap = { brawler: 'POMPADOUR BRAWLER', mech: 'CYBER VALKYRIE', oni: 'ONI SAMURAI', pairA: 'TWIN TITANS (COMBINING!)', pairB: 'TWIN TITANS', triUnit: 'TRI-MECH (COMBINING!)', gattai: '👑 MEGA GATTAI EMPEROR', fortress: '👑 COLOSSUS DREADNOUGHT' };
      document.getElementById('bossBarText').textContent = `${nameMap[b0.type] || 'BOSS'} ${Math.ceil(hp)}`;
    } else {
      bw.style.display = 'none';
    }
  }

  // =========================================================================
  // 9. CEL-SHADED RENDERER (Bridges, Arches, Squad Evolutions, Combiner Bosses)
  // =========================================================================
  function drawBackgroundAndBridges() {
    const cfg = getLevelCfg();
    const skyGrad = ctx.createLinearGradient(0, 0, 0, H * 0.25);
    skyGrad.addColorStop(0, cfg.sky1);
    skyGrad.addColorStop(1, cfg.sky2);
    ctx.fillStyle = skyGrad;
    ctx.fillRect(0, 0, W, H * 0.25);

    const seaGrad = ctx.createLinearGradient(0, H * 0.19, 0, H);
    seaGrad.addColorStop(0, cfg.sea1);
    seaGrad.addColorStop(1, cfg.sea2);
    ctx.fillStyle = seaGrad;
    ctx.fillRect(0, H * 0.19, W, H * 0.81);

    // Ocean shimmer lines
    ctx.fillStyle = 'rgba(255,255,255,0.16)';
    for (let i = 0; i < 16; i++) {
      const wz = ((i * 7 + 100 - (G.scroll % 100)) % 95) + 3;
      const side = i % 2 === 0 ? 1.48 : -2.35;
      const p = proj(side, -0.35, wz);
      ctx.fillRect(p.x - 18 * p.s, p.y, 36 * p.s, 3 * p.s);
    }

    function drawRoadQuad(x1, x2, zNear, zFar, fill) {
      const a = proj(x1, 0, zNear), b = proj(x2, 0, zNear), c = proj(x2, 0, zFar), d = proj(x1, 0, zFar);
      ctx.fillStyle = fill;
      ctx.beginPath();
      ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.lineTo(c.x, c.y); ctx.lineTo(d.x, d.y);
      ctx.closePath(); ctx.fill();
    }

    drawRoadQuad(-1.85, -1.04, -2, 100, '#5a6070');
    drawRoadQuad(-0.92, 0.92, -2, 100, cfg.road);

    // Rim lighting edges on bridge asphalt
    drawRoadQuad(-0.92, -0.87, -2, 100, 'rgba(255,255,255,0.15)');
    drawRoadQuad(0.87, 0.92, -2, 100, 'rgba(0,0,0,0.22)');

    const dashPeriod = 10, offset = G.scroll % dashPeriod;
    for (let z = -offset; z < 98; z += dashPeriod) {
      if (z < -1) continue;
      const z2 = Math.min(98, z + 4.5);
      drawRoadQuad(G.mode === 'vs' ? -0.04 : -0.025, G.mode === 'vs' ? 0.04 : 0.025, Math.max(-1, z), z2, G.mode === 'vs' ? '#ff922b' : 'rgba(255,255,255,0.82)');
      drawRoadQuad(-1.46, -1.43, Math.max(-1, z), z2, 'rgba(255,255,255,0.45)');
    }

    function drawRail(wx, color) {
      const n = proj(wx, 0, -2), f = proj(wx, 0, 100), nT = proj(wx, 0.16, -2), fT = proj(wx, 0.16, 100);
      ctx.fillStyle = color;
      ctx.beginPath(); ctx.moveTo(n.x, n.y); ctx.lineTo(nT.x, nT.y); ctx.lineTo(fT.x, fT.y); ctx.lineTo(f.x, f.y); ctx.closePath(); ctx.fill();
      ctx.strokeStyle = '#111622'; ctx.lineWidth = 1.5; ctx.stroke();
    }
    drawRail(-1.85, '#8d99ae'); drawRail(-1.04, '#8d99ae');
    drawRail(-0.92, '#dee2e6'); drawRail(0.92, '#dee2e6');

    // Speeding Neon Bridge Arches!
    const archPeriod = 26, archOff = G.scroll % archPeriod;
    for (let z = 96 - archOff; z > 2; z -= archPeriod) {
      const lB = proj(-0.92, 0, z), lT = proj(-0.92, 0.95, z), rT = proj(0.92, 0.95, z), rB = proj(0.92, 0, z);
      ctx.strokeStyle = cfg.arch;
      ctx.globalAlpha = Math.min(0.75, 1.1 - z / 98);
      ctx.lineWidth = Math.max(1.5, 6 * lB.s);
      ctx.beginPath();
      ctx.moveTo(lB.x, lB.y); ctx.lineTo(lT.x, lT.y); ctx.lineTo(rT.x, rT.y); ctx.lineTo(rB.x, rB.y);
      ctx.stroke();
    }
    ctx.globalAlpha = 1;
  }

  function drawChibiSoldier(x, y, s, colorMain, colorHat, phase, tier = 0, isAnimeGirl = false, freeze = false) {
    const bob = Math.abs(Math.sin(phase)) * 3 * s;
    const w = 24 * s, h = 30 * s;

    ctx.fillStyle = 'rgba(0,0,0,0.35)';
    ctx.beginPath(); ctx.ellipse(x, y + 2 * s, w * 0.55, w * 0.22, 0, 0, Math.PI * 2); ctx.fill();

    ctx.save();
    ctx.translate(x, y - bob);
    ctx.lineWidth = Math.max(1, 2 * s);
    ctx.strokeStyle = '#0c101d';

    // Tier evolution glow aura for large squads!
    if (tier >= 2) {
      ctx.fillStyle = tier >= 3 ? 'rgba(255, 212, 59, 0.35)' : 'rgba(56, 249, 215, 0.25)';
      ctx.beginPath(); ctx.arc(0, -h * 0.5, w * 0.72, 0, Math.PI * 2); ctx.fill();
    }

    ctx.fillStyle = freeze ? '#74c0fc' : (tier >= 3 ? '#ffd43b' : colorMain);
    ctx.beginPath(); ctx.roundRect(-w * 0.42, -h * 0.58, w * 0.84, h * 0.5, 5 * s); ctx.fill(); ctx.stroke();

    // Specular shading highlight
    ctx.fillStyle = 'rgba(255,255,255,0.22)';
    ctx.fillRect(-w * 0.34, -h * 0.54, w * 0.2, h * 0.4);

    // Bandolier
    ctx.strokeStyle = tier >= 2 ? '#38f9d7' : '#ffd43b';
    ctx.lineWidth = Math.max(1.5, 2.8 * s);
    ctx.beginPath(); ctx.moveTo(-w * 0.3, -h * 0.55); ctx.lineTo(w * 0.3, -h * 0.12); ctx.stroke();

    // Head
    ctx.strokeStyle = '#0c101d'; ctx.lineWidth = Math.max(1, 2 * s);
    ctx.fillStyle = freeze ? '#a5d8ff' : '#ffdfc4';
    ctx.beginPath(); ctx.arc(0, -h * 0.78, w * 0.34, 0, Math.PI * 2); ctx.fill(); ctx.stroke();

    // Hair / Helmet / Visor
    ctx.fillStyle = colorHat;
    ctx.beginPath(); ctx.arc(0, -h * 0.86, w * 0.36, Math.PI, 0); ctx.fill(); ctx.stroke();
    if (tier >= 1) {
      ctx.fillStyle = '#38f9d7';
      ctx.fillRect(-w * 0.25, -h * 0.82, w * 0.5, h * 0.08);
    }
    if (isAnimeGirl) {
      ctx.fillStyle = colorHat;
      ctx.beginPath();
      ctx.ellipse(-w * 0.38, -h * 0.72, w * 0.12, h * 0.2, 0.3, 0, Math.PI * 2);
      ctx.ellipse(w * 0.38, -h * 0.72, w * 0.12, h * 0.2, -0.3, 0, Math.PI * 2);
      ctx.fill(); ctx.stroke();
    }

    ctx.fillStyle = '#343a40';
    ctx.fillRect(w * 0.24, -h * 0.46, w * 0.28, h * 0.14);
    ctx.strokeRect(w * 0.24, -h * 0.46, w * 0.28, h * 0.14);
    ctx.restore();
  }

  function drawBoss(x, y, s, e) {
    const isMega = e.type === 'gattai' || e.type === 'fortress';
    const scaleMult = isMega ? 1.45 : (e.type === 'triUnit' ? 0.85 : 1.0);
    const bounce = Math.abs(Math.sin(e.phase * 0.5)) * 6 * s;
    const w = 96 * s * scaleMult, h = 135 * s * scaleMult;

    ctx.fillStyle = 'rgba(0,0,0,0.48)';
    ctx.beginPath(); ctx.ellipse(x, y + 4 * s, w * 0.65, w * 0.22, 0, 0, Math.PI * 2); ctx.fill();

    ctx.save();
    ctx.translate(x, y - bounce);
    ctx.lineWidth = Math.max(1.5, 3 * s);
    ctx.strokeStyle = '#12080a';

    // Mega Gattai Halo / Reactor!
    if (isMega) {
      ctx.strokeStyle = '#ffd43b';
      ctx.lineWidth = Math.max(2, 4 * s);
      ctx.beginPath(); ctx.arc(0, -h * 0.6, w * 0.72, 0, Math.PI * 2); ctx.stroke();
      ctx.strokeStyle = '#12080a';
      ctx.lineWidth = Math.max(1.5, 3 * s);
    }

    const bodyCol = e.hitFlash > 0 ? '#fff' : (e.freezeT > 0 ? '#4dabf7' :
      e.type === 'mech' || e.type === 'triUnit' ? '#7048e8' :
      e.type === 'oni' ? '#2b2d42' :
      e.type === 'gattai' ? '#f59f00' :
      e.type === 'fortress' ? '#0ca678' :
      e.type === 'pairB' ? '#f59f00' : '#d62828');

    // Legs
    ctx.fillStyle = '#1f2433';
    ctx.fillRect(-w * 0.26, -h * 0.28, w * 0.18, h * 0.28);
    ctx.fillRect(w * 0.08, -h * 0.28, w * 0.18, h * 0.28);

    // Torso / Armor
    ctx.fillStyle = bodyCol;
    ctx.beginPath(); ctx.roundRect(-w * 0.52, -h * 0.78, w * 1.04, h * 0.54, 14 * s); ctx.fill(); ctx.stroke();
    // Cel-shade highlight
    ctx.fillStyle = 'rgba(255,255,255,0.22)';
    ctx.fillRect(-w * 0.44, -h * 0.74, w * 0.24, h * 0.44);

    // Glowing Reactor Core for Mechs / Gattai
    if (e.type !== 'brawler') {
      ctx.fillStyle = '#38f9d7';
      ctx.beginPath(); ctx.arc(0, -h * 0.54, w * 0.16, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
    } else {
      ctx.fillStyle = '#f1f3f5';
      ctx.fillRect(-w * 0.18, -h * 0.75, w * 0.36, h * 0.45);
    }

    // Fists / Cannons
    ctx.fillStyle = e.type === 'brawler' || e.type === 'pairA' || e.type === 'pairB' ? '#ffcdb2' : '#495057';
    ctx.beginPath();
    ctx.arc(-w * 0.56, -h * 0.34, w * 0.17, 0, Math.PI * 2);
    ctx.arc(w * 0.56, -h * 0.34, w * 0.17, 0, Math.PI * 2);
    ctx.fill(); ctx.stroke();

    // Head
    ctx.fillStyle = e.type === 'brawler' || e.type === 'pairA' || e.type === 'pairB' ? '#ffcdb2' : '#343a40';
    ctx.beginPath(); ctx.arc(0, -h * 0.88, w * 0.24, 0, Math.PI * 2); ctx.fill(); ctx.stroke();

    // Crown / Horns / Pompadour
    if (e.type === 'oni' || isMega) {
      ctx.fillStyle = '#ffd43b';
      ctx.beginPath();
      ctx.moveTo(-w * 0.18, -h * 0.96); ctx.lineTo(-w * 0.36, -h * 1.24); ctx.lineTo(-w * 0.04, -h * 1.04);
      ctx.moveTo(w * 0.18, -h * 0.96); ctx.lineTo(w * 0.36, -h * 1.24); ctx.lineTo(w * 0.04, -h * 1.04);
      ctx.fill(); ctx.stroke();
    } else {
      ctx.fillStyle = '#f59f00';
      ctx.beginPath(); ctx.moveTo(-w * 0.2, -h * 0.98); ctx.quadraticCurveTo(0, -h * 1.24, w * 0.26, -h * 0.96); ctx.closePath(); ctx.fill(); ctx.stroke();
    }

    ctx.fillStyle = e.type === 'brawler' ? '#111' : '#ff2e63';
    ctx.fillRect(-w * 0.16, -h * 0.91, w * 0.32, h * 0.04);
    ctx.restore();
  }

  function drawGate(g) {
    const p = proj(g.wx, 0, g.wz);
    if (p.s <= 0.05) return;
    const gw = g.w * Math.min(W * 0.44, 240) * p.s;
    const gh = 115 * p.s;
    const isPw = g.op === 'pw';
    const isGood = isPw || g.op === 'x' || g.val >= 0;

    ctx.save();
    ctx.fillStyle = isPw ? '#9775fa' : (isGood ? '#12b886' : '#fa5252');
    ctx.fillRect(p.x - gw * 0.5, p.y - gh, 8 * p.s, gh);
    ctx.fillRect(p.x + gw * 0.5 - 8 * p.s, p.y - gh, 8 * p.s, gh);

    const grad = ctx.createLinearGradient(0, p.y - gh, 0, p.y);
    grad.addColorStop(0, isPw ? 'rgba(151, 117, 250, 0.8)' : (isGood ? 'rgba(34, 229, 138, 0.75)' : 'rgba(255, 59, 59, 0.8)'));
    grad.addColorStop(1, isPw ? 'rgba(76, 110, 245, 0.3)' : (isGood ? 'rgba(12, 133, 153, 0.32)' : 'rgba(180, 20, 20, 0.35)'));
    ctx.fillStyle = grad;
    ctx.fillRect(p.x - gw * 0.5 + 4 * p.s, p.y - gh + 6 * p.s, gw - 8 * p.s, gh - 6 * p.s);

    let label = '';
    if (isPw) {
      const pu = POWERUPS[g.val] || POWERUPS[0];
      label = `${pu.icon} ${pu.name}`;
    } else {
      label = g.op === 'x' ? `x${g.val}` : (g.val >= 0 ? `+${g.val}` : `${g.val}`);
    }
    ctx.font = `900 ${Math.max(10, Math.floor((isPw ? 17 : 36) * p.s))}px system-ui`;
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.lineWidth = Math.max(2, 4.5 * p.s); ctx.strokeStyle = '#090d16';
    ctx.strokeText(label, p.x, p.y - gh * 0.52);
    ctx.fillStyle = '#fff';
    ctx.fillText(label, p.x, p.y - gh * 0.52);
    ctx.restore();
  }

  function drawBarricade(bar) {
    const p = proj(bar.wx, 0, bar.wz);
    if (p.s <= 0.05) return;
    const bw = bar.w * Math.min(W * 0.44, 240) * p.s, bh = 74 * p.s;

    ctx.save();
    const tireW = bw / 4;
    for (let i = 0; i < 4; i++) {
      const tx = p.x - bw * 0.5 + i * tireW;
      ctx.fillStyle = bar.hitFlash > 0 ? '#ffe066' : '#252932';
      ctx.strokeStyle = '#0a0c10'; ctx.lineWidth = Math.max(1, 2 * p.s);
      ctx.beginPath(); ctx.roundRect(tx + 1, p.y - bh, tireW - 2, bh, 6 * p.s); ctx.fill(); ctx.stroke();
      ctx.fillStyle = '#3b414f';
      for (let t = 0.2; t < 0.9; t += 0.25) ctx.fillRect(tx + 3 * p.s, p.y - bh * t, tireW - 6 * p.s, 4 * p.s);
    }

    const hover = Math.sin(performance.now() * 0.006) * 8 * p.s;
    const pu = POWERUPS[bar.reward] || POWERUPS[1];
    ctx.fillStyle = pu.color;
    ctx.shadowColor = pu.color; ctx.shadowBlur = 14 * p.s;
    ctx.beginPath(); ctx.arc(p.x, p.y - bh - 26 * p.s + hover, 16 * p.s, 0, Math.PI * 2); ctx.fill();
    ctx.shadowBlur = 0;

    ctx.font = `900 ${Math.max(9, Math.floor(12 * p.s))}px system-ui`;
    ctx.textAlign = 'center'; ctx.fillStyle = '#fff';
    ctx.fillText(`${pu.icon} ${pu.name}`, p.x, p.y - bh - 49 * p.s + hover);

    ctx.font = `900 ${Math.max(12, Math.floor(27 * p.s))}px system-ui`;
    ctx.textBaseline = 'middle'; ctx.lineWidth = Math.max(2, 4 * p.s); ctx.strokeStyle = '#000';
    const hpTxt = Math.ceil(bar.hp).toString();
    ctx.strokeText(hpTxt, p.x, p.y - bh * 0.5); ctx.fillStyle = '#fff'; ctx.fillText(hpTxt, p.x, p.y - bh * 0.5);
    ctx.restore();
  }

  function render() {
    ctx.save();
    if (G.shake > 0.2) ctx.translate((Math.random() - 0.5) * G.shake, (Math.random() - 0.5) * G.shake);

    drawBackgroundAndBridges();

    for (const d of G.hordeDeco) {
      const p = proj(d.wx, 0, d.wz);
      if (p.s < 0.06) continue;
      const r = 7 * p.s;
      ctx.fillStyle = '#d92626';
      ctx.beginPath(); ctx.arc(p.x, p.y - r + Math.abs(Math.sin(d.phase)) * 2 * p.s, r, 0, Math.PI * 2); ctx.fill();
    }

    // Shockwaves on bridge surface
    for (const sw of G.shockwaves) {
      const p = proj(sw.wx, 0.02, sw.wz);
      const rad = sw.r * Math.min(W * 0.44, 240) * p.s;
      ctx.strokeStyle = sw.color;
      ctx.globalAlpha = Math.max(0, sw.life * 1.5);
      ctx.lineWidth = Math.max(2, 6 * p.s);
      ctx.beginPath(); ctx.ellipse(p.x, p.y, rad, rad * 0.35, 0, 0, Math.PI * 2); ctx.stroke();
    }
    ctx.globalAlpha = 1;

    // Double-Tap Bomb Target Reticles!
    for (const bs of G.bombStrikes) {
      const p = proj(bs.wx, 0.02, bs.wz);
      const rad = 64 * p.s * (0.5 + 0.5 * (bs.timer / bs.maxT));
      ctx.strokeStyle = '#ff3b3b';
      ctx.lineWidth = 3;
      ctx.beginPath(); ctx.ellipse(p.x, p.y, rad, rad * 0.4, 0, 0, Math.PI * 2); ctx.stroke();
      // Falling missile
      const missY = p.y - (bs.timer / bs.maxT) * H * 0.55;
      ctx.fillStyle = '#ffd43b';
      ctx.beginPath(); ctx.arc(p.x, missY, 9 * p.s + 3, 0, Math.PI * 2); ctx.fill();
    }

    const drawList = [];
    for (const g of G.gates) drawList.push({ z: g.wz, fn: () => drawGate(g) });
    for (const b of G.barricades) drawList.push({ z: b.wz, fn: () => drawBarricade(b) });

    for (const br of G.barrels) {
      drawList.push({
        z: br.wz,
        fn: () => {
          const p = proj(br.wx, 0, br.wz);
          if (p.s < 0.05) return;
          const bw = 26 * p.s, bh = 36 * p.s;
          ctx.fillStyle = br.hitFlash > 0 ? '#fff' : '#e03131';
          ctx.strokeStyle = '#111'; ctx.lineWidth = Math.max(1, 2 * p.s);
          ctx.beginPath(); ctx.roundRect(p.x - bw * 0.5, p.y - bh, bw, bh, 4 * p.s); ctx.fill(); ctx.stroke();
          ctx.fillStyle = '#ffd43b'; ctx.fillRect(p.x - bw * 0.48, p.y - bh * 0.6, bw * 0.96, bh * 0.22);
          ctx.fillStyle = 'rgba(255,255,255,0.28)'; ctx.fillRect(p.x - bw * 0.35, p.y - bh + 2, bw * 0.2, bh - 4);
        }
      });
    }

    for (const cr of G.crates) {
      drawList.push({
        z: cr.wz,
        fn: () => {
          const p = proj(cr.wx, 0, cr.wz);
          if (p.s < 0.05) return;
          const sz = 32 * p.s;
          ctx.fillStyle = cr.hitFlash > 0 ? '#fff' : '#f59f00';
          ctx.strokeStyle = '#111'; ctx.lineWidth = Math.max(1, 2 * p.s);
          ctx.beginPath(); ctx.roundRect(p.x - sz * 0.5, p.y - sz, sz, sz, 5 * p.s); ctx.fill(); ctx.stroke();
          ctx.font = `900 ${Math.max(10, Math.floor(20 * p.s))}px system-ui`;
          ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillStyle = '#fff';
          ctx.fillText('?', p.x, p.y - sz * 0.5);
        }
      });
    }

    for (const sw of G.saws) {
      drawList.push({
        z: sw.wz,
        fn: () => {
          const p = proj(sw.wx, 0.08, sw.wz);
          if (p.s < 0.05) return;
          ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(sw.rot);
          const r = 20 * p.s;
          ctx.fillStyle = '#ced4da'; ctx.strokeStyle = '#111'; ctx.lineWidth = 2;
          ctx.beginPath(); ctx.arc(0, 0, r, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
          ctx.fillStyle = '#ff3b3b'; ctx.beginPath(); ctx.arc(0, 0, r * 0.35, 0, Math.PI * 2); ctx.fill();
          ctx.restore();
        }
      });
    }

    for (const c of G.coins) {
      drawList.push({
        z: c.wz,
        fn: () => {
          const p = proj(c.wx, 0.12, c.wz);
          if (p.s < 0.05) return;
          ctx.fillStyle = '#ffd43b'; ctx.strokeStyle = '#9c6b00'; ctx.lineWidth = 1.5;
          ctx.beginPath(); ctx.arc(p.x, p.y, 10 * p.s, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
        }
      });
    }

    for (const e of G.enemies) {
      drawList.push({
        z: e.wz,
        fn: () => {
          const p = proj(e.wx, e.wy, e.wz);
          if (p.s < 0.05) return;
          const isBoss = ['brawler', 'mech', 'oni', 'pairA', 'pairB', 'triUnit', 'gattai', 'fortress'].includes(e.type);
          if (isBoss) drawBoss(p.x, p.y, p.s, e);
          else {
            const sc = e.type === 'heavy' ? p.s * 1.25 : p.s * 0.9;
            drawChibiSoldier(p.x, p.y, sc, e.hitFlash > 0 ? '#fff' : (e.type === 'heavy' ? '#9c36b5' : '#e03131'), '#a61e1e', e.phase, 0, false, e.freezeT > 0);
          }
        }
      });
    }

    // Player Squads with Visible Troop Evolution!
    [1, 2].forEach(pid => {
      if (pid === 2 && !G.is2P) return;
      const pl = G.players[pid];
      if (pl.count <= 0 && pl.downed <= 0) return;

      drawList.push({
        z: 2.0,
        fn: () => {
          const tier = pl.count >= 50 ? 3 : pl.count >= 25 ? 2 : pl.count >= 12 ? 1 : 0;
          const visible = Math.min(34, Math.max(1, pl.count));
          const cols = Math.min(6, Math.ceil(Math.sqrt(visible)));
          for (let i = 0; i < visible; i++) {
            const row = Math.floor(i / cols), col = i % cols;
            const wx = pl.x + (col - (cols - 1) / 2) * 0.085, wz = 2.0 - row * 0.85;
            const p = proj(wx, 0, wz);
            drawChibiSoldier(p.x, p.y, p.s, pid === 1 ? '#228be6' : '#e64980', pid === 1 ? '#1864ab' : '#ffd43b', G.scroll * 0.55 + i, tier, pid === 2);
          }

          // Titan Shield Bubble
          if (pl.buffs.shield > 0) {
            const sp = proj(pl.x, 0.16, 2.0);
            ctx.strokeStyle = '#4dabf7'; ctx.fillStyle = 'rgba(77, 171, 247, 0.18)'; ctx.lineWidth = 3;
            ctx.beginPath(); ctx.arc(sp.x, sp.y, 44, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
          }

          // Autonomous Drone Squad hovering beside squad!
          if (pl.buffs.drones > 0) {
            [-0.26, 0.26].forEach(dx => {
              const dp = proj(pl.x + dx, 0.36 + Math.sin(performance.now() * 0.008) * 0.04, 2.1);
              ctx.fillStyle = '#66d9e8'; ctx.strokeStyle = '#111'; ctx.lineWidth = 2;
              ctx.beginPath(); ctx.arc(dp.x, dp.y, 10, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
            });
          }

          const headP = proj(pl.x, 0.52, 2.0);
          ctx.font = '900 15px system-ui'; ctx.textAlign = 'center'; ctx.lineWidth = 4; ctx.strokeStyle = '#000';
          const tag = pl.downed > 0 ? `SOS ${Math.ceil(pl.downed)}s` : `P${pid} • ${pl.count}`;
          ctx.strokeText(tag, headP.x, headP.y);
          ctx.fillStyle = pid === 1 ? '#74c0fc' : '#faa2c1';
          ctx.fillText(tag, headP.x, headP.y);

          if (pl.tauntT > 0 && pl.taunt) {
            ctx.fillStyle = '#fff';
            ctx.beginPath(); ctx.roundRect(headP.x - 52, headP.y - 42, 104, 24, 10); ctx.fill();
            ctx.fillStyle = '#111'; ctx.font = '900 12px system-ui';
            ctx.fillText(pl.taunt, headP.x, headP.y - 26);
          }
        }
      });
    });

    drawList.sort((a, b) => b.z - a.z);
    for (const item of drawList) item.fn();

    // Bullets, Axes, Black Holes
    for (const b of G.bullets) {
      const pu = POWERUPS[b.wep] || POWERUPS[0];
      const p1 = proj(b.wx, b.wy, b.wz);
      if (pu.vortex) {
        ctx.fillStyle = '#110022'; ctx.strokeStyle = '#c77dff'; ctx.lineWidth = 3;
        ctx.beginPath(); ctx.arc(p1.x, p1.y, 16 * p1.s + 4, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      } else if (pu.ricochet || pu.boomerang) {
        ctx.save(); ctx.translate(p1.x, p1.y); ctx.rotate(performance.now() * 0.02);
        ctx.fillStyle = pu.color; ctx.fillRect(-10 * p1.s, -3 * p1.s, 20 * p1.s, 6 * p1.s);
        ctx.fillRect(-3 * p1.s, -10 * p1.s, 6 * p1.s, 20 * p1.s);
        ctx.restore();
      } else {
        const p2 = proj(b.wx, b.wy, Math.max(0, b.wz - 3.4));
        ctx.strokeStyle = pu.color;
        ctx.lineWidth = Math.max(2, (b.wep === 1 || b.wep === 11 ? 6 : 4) * p1.s);
        ctx.beginPath(); ctx.moveTo(p2.x, p2.y); ctx.lineTo(p1.x, p1.y); ctx.stroke();
      }
    }

    // Chain Lightning Arcs
    ctx.strokeStyle = '#4cc9f0'; ctx.lineWidth = 3;
    for (const la of G.lightningArcs) {
      const a = proj(la.x1, 0.25, la.z1), b = proj(la.x2, 0.25, la.z2);
      ctx.beginPath(); ctx.moveTo(a.x, a.y);
      ctx.lineTo((a.x + b.x) * 0.5 + (Math.random() - 0.5) * 24, (a.y + b.y) * 0.5 + (Math.random() - 0.5) * 18);
      ctx.lineTo(b.x, b.y); ctx.stroke();
    }

    // Ragdolls, Casings, Particles, Popups
    for (const r of G.ragdolls) {
      const p = proj(r.wx, r.wy, r.wz);
      ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(r.rot);
      const sz = (r.isBoss ? 36 : 12) * p.s;
      ctx.fillStyle = '#ff3b3b'; ctx.fillRect(-sz * 0.5, -sz * 0.5, sz, sz * 1.2);
      ctx.restore();
    }
    ctx.fillStyle = '#ffd43b';
    for (const c of G.casings) { const p = proj(c.wx, c.wy, c.wz); ctx.fillRect(p.x, p.y, 4 * p.s, 2 * p.s); }
    for (const pt of G.particles) {
      const p = proj(pt.wx, pt.wy, pt.wz);
      ctx.fillStyle = pt.color; ctx.globalAlpha = Math.max(0, pt.life * 1.5);
      ctx.beginPath(); ctx.arc(p.x, p.y, pt.size * p.s, 0, Math.PI * 2); ctx.fill();
    }
    ctx.globalAlpha = 1;

    // Weather Overlay (Rain, Sakura, Embers, Snow, Stars)
    const wxFx = getLevelCfg().wxFx;
    if (wxFx !== 'none') {
      for (const w of G.weather) {
        if (wxFx === 'rain') {
          ctx.strokeStyle = 'rgba(165, 216, 255, 0.4)'; ctx.lineWidth = 1.5;
          ctx.beginPath(); ctx.moveTo(w.x, w.y); ctx.lineTo(w.x - 4, w.y + 14); ctx.stroke();
        } else if (wxFx === 'sakura') {
          ctx.fillStyle = 'rgba(255, 180, 210, 0.75)';
          ctx.beginPath(); ctx.ellipse(w.x, w.y, 5, 3, w.y * 0.05, 0, Math.PI * 2); ctx.fill();
        } else if (wxFx === 'embers') {
          ctx.fillStyle = 'rgba(255, 120, 40, 0.8)';
          ctx.beginPath(); ctx.arc(w.x, H - w.y, 2.5, 0, Math.PI * 2); ctx.fill();
        } else {
          ctx.fillStyle = 'rgba(255,255,255,0.65)';
          ctx.beginPath(); ctx.arc(w.x, w.y, w.s * 0.5, 0, Math.PI * 2); ctx.fill();
        }
      }
    }

    for (const pop of G.popups) {
      const p = proj(pop.wx, pop.wy, pop.wz);
      ctx.globalAlpha = Math.max(0, pop.life / pop.maxLife);
      ctx.font = `900 ${pop.size}px system-ui`; ctx.textAlign = 'center';
      ctx.lineWidth = 4; ctx.strokeStyle = '#000';
      ctx.strokeText(pop.text, p.x, p.y); ctx.fillStyle = pop.color; ctx.fillText(pop.text, p.x, p.y);
    }
    ctx.globalAlpha = 1;

    if (G.speedLines > 0 || G.players[G.myId].ultActive > 0 || G.combo >= 15) {
      ctx.strokeStyle = G.combo >= 15 ? 'rgba(255, 212, 59, 0.2)' : 'rgba(255,255,255,0.2)';
      ctx.lineWidth = 2;
      for (let i = 0; i < 16; i++) {
        const ang = (i / 16) * Math.PI * 2 + performance.now() * 0.01;
        ctx.beginPath();
        ctx.moveTo(W * 0.5 + Math.cos(ang) * W * 0.26, H * 0.45 + Math.sin(ang) * H * 0.26);
        ctx.lineTo(W * 0.5 + Math.cos(ang) * W * 0.85, H * 0.45 + Math.sin(ang) * H * 0.85);
        ctx.stroke();
      }
    }

    if (G.flash > 0) {
      ctx.fillStyle = `rgba(255, 240, 200, ${G.flash})`;
      ctx.fillRect(0, 0, W, H);
    }
    ctx.restore();
  }

  // =========================================================================
  // 10. INPUT (Drag Steering + Clean Double-Tap Tactical Bombing!)
  // =========================================================================
  let dragging = false, downX = 0, downY = 0, downTime = 0, lastDragX = 0;
  let lastTapTime = 0, lastTapX = 0, lastTapY = 0;

  canvas.addEventListener('pointerdown', (e) => {
    SoundFX.unlock();
    dragging = true;
    downX = lastDragX = e.clientX;
    downY = e.clientY;
    downTime = performance.now();
  });
  window.addEventListener('pointermove', (e) => {
    if (!dragging || !G.running) return;
    const dx = e.clientX - lastDragX;
    lastDragX = e.clientX;
    const p = G.players[G.myId];
    if (p) p.targetX += dx / Math.min(W * 0.42, 210);
  });
  window.addEventListener('pointerup', (e) => {
    if (!dragging) return;
    dragging = false;
    if (!G.running) return;
    const distMoved = Math.hypot(e.clientX - downX, e.clientY - downY);
    const dur = performance.now() - downTime;
    if (distMoved < 16 && dur < 240) {
      const now = performance.now();
      if (now - lastTapTime < 340 && Math.hypot(e.clientX - lastTapX, e.clientY - lastTapY) < 55) {
        const worldPt = unproj(e.clientX, e.clientY);
        triggerMyBomb(worldPt.wx, worldPt.wz);
        lastTapTime = 0;
      } else {
        lastTapTime = now; lastTapX = e.clientX; lastTapY = e.clientY;
      }
    }
  });
  window.addEventListener('pointercancel', () => { dragging = false; });

  const keys = {};
  window.addEventListener('keydown', (e) => {
    keys[e.code] = true;
    if (e.code === 'Space' && G.running) triggerMyUlt();
    if (e.code === 'KeyB' && G.running) triggerMyBomb(G.players[G.myId].x, 38);
  });
  window.addEventListener('keyup', (e) => { keys[e.code] = false; });

  function handleKeyboard(dt) {
    if (!G.running) return;
    const p = G.players[G.myId];
    if (!p) return;
    if (keys['ArrowLeft'] || keys['KeyA']) p.targetX -= dt * 1.45;
    if (keys['ArrowRight'] || keys['KeyD']) p.targetX += dt * 1.45;
  }

  function triggerMyUlt() {
    SoundFX.unlock();
    if (G.is2P && G.myId === 2) Net.send({ t: 'ult' });
    else activateUlt(1);
  }

  function triggerMyBomb(wx = null, wz = 42) {
    SoundFX.unlock();
    const targetWx = wx !== null ? wx : G.players[G.myId].x;
    if (G.is2P && G.myId === 2) Net.send({ t: 'bomb', wx: targetWx, wz });
    else dropBombStrike(1, targetWx, wz);
  }

  document.getElementById('btnUlt').onclick = triggerMyUlt;
  document.getElementById('btnBomb').onclick = () => triggerMyBomb(G.players[G.myId].x, 40);

  document.querySelectorAll('.taunt-btn').forEach(btn => {
    btn.onclick = () => {
      SoundFX.unlock();
      const msg = btn.dataset.taunt;
      const p = G.players[G.myId];
      p.taunt = msg; p.tauntT = 2.0;
      if (G.is2P) Net.send({ t: 'taunt', msg });
    };
  });

  // =========================================================================
  // 11. LOBBY, LEVEL SELECTOR, QR & NETWORK WIRING
  // =========================================================================
  const $ = id => document.getElementById(id);
  const startLvlSel = $('startLevelSelect');
  startLvlSel.innerHTML = '';
  LEVELS.forEach(l => {
    const opt = document.createElement('option');
    opt.value = l.id;
    opt.textContent = `LVL ${l.id} - ${l.name}`;
    startLvlSel.appendChild(opt);
  });

  const BUILD = '20261126-qr2';
  const DEFAULT_STATUS = 'Drag to steer • DOUBLE-TAP bridge to drop tactical bombs!';
  const lobbyView = $('lobbyView'), hostView = $('hostView');
  const gameOverView = $('gameOverView'), modal = $('modal');
  const joinInput = $('joinCodeInput'), joinButton = $('btnJoinCode');
  const cancelJoin = $('btnCancelJoin'), launchButton = $('btnStartCoopNow');
  const copyButton = $('btnCopyLink'), hostRetry = $('btnRetryHost');
  const inviteInput = $('inviteLinkInput');
  const hostStatus = $('hostStatus'), lobbyStatus = $('lobbyStatus');
  let selectedMode = 'coop', joining = false, hostRoute = '', guestRoute = '';
  let lastInvite = '';

  const cleanMode = mode => mode === 'vs' ? 'vs' : 'coop';
  function setMode(mode) {
    selectedMode = cleanMode(mode);
    $('modeCoop').classList.toggle('active', selectedMode === 'coop');
    $('modeVs').classList.toggle('active', selectedMode === 'vs');
  }
  $('modeCoop').onclick = () => setMode('coop');
  $('modeVs').onclick = () => setMode('vs');

  function inviteFrom(input, modeHint = selectedMode) {
    let raw = String(input || '').trim();
    let mode = cleanMode(modeHint);
    if (!raw) return null;
    // Accept a whole camera/share link, a query/hash, or the manually typed code.
    try {
      if (/^(?:https?:\/\/|[?#])/i.test(raw)) {
        const url = new URL(raw, location.href);
        const hash = new URLSearchParams(url.hash.replace(/^#/, '').replace(/^\?/, ''));
        raw = url.searchParams.get('join') || hash.get('join') || '';
        mode = cleanMode(url.searchParams.get('mode') || hash.get('mode') || mode);
      }
    } catch { return null; }
    const code = raw.toUpperCase().replace(/^BC2P-/, '').replace(/[\s-]/g, '');
    return /^[A-HJ-NP-Z2-9]{5,10}$/.test(code) ? { code, mode } : null;
  }

  function inviteURL(code) {
    const url = new URL(location.href);
    url.search = ''; url.hash = '';
    url.searchParams.set('join', code);
    url.searchParams.set('mode', selectedMode);
    url.searchParams.set('v', BUILD);
    return url.href;
  }

  function clearInviteURL() {
    try {
      const u = new URL(location.href);
      u.searchParams.delete('join'); u.searchParams.delete('mode'); u.searchParams.delete('v');
      const hash = new URLSearchParams(u.hash.replace(/^#/, '').replace(/^\?/, ''));
      if (hash.has('join')) u.hash = '';
      history.replaceState(null, '', u);
    } catch {}
  }

  function setJoinBusy(busy) {
    joining = busy;
    joinButton.disabled = busy;
    joinInput.disabled = busy;
    $('modeCoop').disabled = busy; $('modeVs').disabled = busy;
    startLvlSel.disabled = busy;
    $('btnHost2P').disabled = busy;
    $('btnPlaySolo').disabled = busy;
    cancelJoin.style.display = busy ? 'flex' : 'none';
    joinButton.textContent = busy ? 'JOINING…' : 'JOIN';
  }

  function showLobby(message = DEFAULT_STATUS) {
    G.running = false;
    $('hud').style.display = 'none';
    modal.classList.remove('hidden');
    lobbyView.style.display = 'block';
    hostView.style.display = 'none';
    gameOverView.style.display = 'none';
    setJoinBusy(false);
    lobbyStatus.textContent = message;
  }

  function safeSound(fn) { try { fn(); } catch {} }
  $('btnPlaySolo').onclick = () => {
    safeSound(() => SoundFX.unlock());
    Net.destroy(); setJoinBusy(false); clearInviteURL();
    resetGame(false, 1, 'coop', Number(startLvlSel.value) || 1);
  };

  function setLaunch(enabled) {
    launchButton.disabled = !enabled;
    launchButton.style.display = enabled ? 'flex' : 'none';
  }

  function startHosting() {
    safeSound(() => SoundFX.unlock());
    clearInviteURL();
    setJoinBusy(false);
    lobbyView.style.display = 'none'; hostView.style.display = 'block';
    gameOverView.style.display = 'none';
    modal.classList.remove('hidden');
    hostRoute = '';
    lastInvite = '';
    $('qrContainer').textContent = 'Generating QR…';
    $('qrContainer').removeAttribute('title');
    $('roomCodeDisplay').textContent = '--------';
    inviteInput.value = '';
    inviteInput.style.display = 'none';
    $('copyStatus').textContent = '';
    copyButton.disabled = true; hostRetry.style.display = 'none';
    hostStatus.textContent = 'Opening Internet pairing service…';
    setLaunch(false);
    Net.hostRoom(code => {
      $('roomCodeDisplay').textContent = code;
      lastInvite = inviteURL(code);
      const qrBox = $('qrContainer');
      qrBox.textContent = '';
      qrBox.title = lastInvite;
      try {
        new QRCode(qrBox, { text: lastInvite, width: 220, height: 220, correctLevel: QRCode.CorrectLevel.M });
      } catch {
        qrBox.textContent = 'QR unavailable — copy the link or use the room code.';
      }
      // The URL and code remain usable even if camera/clipboard access fails.
      inviteInput.value = lastInvite;
      inviteInput.style.display = 'block';
      copyButton.disabled = false;
      hostRetry.style.display = 'none';
      hostStatus.textContent = 'Room ready! Scan this QR with Player 2’s phone. Keep this screen open.';
    }, msg => { hostStatus.textContent = msg; },
    err => {
      setLaunch(false);
      hostStatus.textContent = err;
      hostRetry.style.display = 'flex';
      copyButton.disabled = true;
      inviteInput.style.display = 'none';
      $('qrContainer').textContent = 'Room closed — tap Retry';
      $('qrContainer').removeAttribute('title');
      $('roomCodeDisplay').textContent = '--------';
    });
  }

  $('btnHost2P').onclick = startHosting;
  hostRetry.onclick = startHosting;
  copyButton.onclick = async () => {
    if (!lastInvite || copyButton.disabled) return;
    try {
      if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable');
      await navigator.clipboard.writeText(lastInvite);
      $('copyStatus').textContent = 'Invite copied! Send it to Player 2.';
    } catch {
      inviteInput.focus(); inviteInput.select();
      try {
        if (document.execCommand('copy')) { $('copyStatus').textContent = 'Invite copied!'; return; }
      } catch {}
      $('copyStatus').textContent = 'Link selected — press and hold, then Copy.';
    }
  };
  $('btnCancelHost').onclick = () => { Net.destroy(); setLaunch(false); showLobby(); };
  launchButton.onclick = () => {
    if (!Net.isConnected() || Net.getRole() !== 'host') { setLaunch(false); hostStatus.textContent = 'Wait for Player 2 to connect.'; return; }
    const startLvl = Number(startLvlSel.value) || 1;
    if (!Net.send({ t: 'start', mode: selectedMode, lvl: startLvl })) {
      hostStatus.textContent = 'The connection closed. Wait for Player 2 to rejoin.';
      setLaunch(false); return;
    }
    setLaunch(false);
    resetGame(true, 1, selectedMode, startLvl);
  };

  function startJoin(value, modeHint = selectedMode) {
    if (joining) return;
    const invite = inviteFrom(value, modeHint);
    if (!invite) {
      lobbyStatus.textContent = 'Enter the room code or paste the host’s invitation link.';
      return;
    }
    setMode(invite.mode);
    joinInput.value = invite.code;
    guestRoute = '';
    setJoinBusy(true);
    lobbyStatus.textContent = 'Connecting automatically to room ' + invite.code + '…';
    Net.joinRoom(invite.code,
      msg => { lobbyStatus.textContent = msg; },
      err => {
        setJoinBusy(false);
        lobbyStatus.textContent = err;
      });
  }
  joinButton.onclick = () => { safeSound(() => SoundFX.unlock()); startJoin(joinInput.value); };
  joinInput.addEventListener('keydown', e => {
    if (e.key === 'Enter' && !joining) { e.preventDefault(); joinButton.click(); }
  });
  cancelJoin.onclick = () => { Net.destroy(); clearInviteURL(); setJoinBusy(false); lobbyStatus.textContent = 'Join cancelled. Enter a room code or scan a new QR.'; };

  Net.setHandlers({
    onConnected(role) {
      if (role === 'host') {
        hostStatus.textContent = '✅ PLAYER 2 CONNECTED! Ready to launch.';
        setLaunch(true);
      } else {
        lobbyStatus.textContent = '✅ Connected! Waiting for Player 1 to launch…';
        setJoinBusy(true);
        joinButton.textContent = 'JOINED';
      }
      safeSound(() => SoundFX.powerup());
    },
    onRoute(role, label) {
      if (role === 'host') {
        hostRoute = label;
        if (!G.running && Net.isConnected()) hostStatus.textContent = '✅ PLAYER 2 CONNECTED • ' + label + '. Ready to launch.';
      } else {
        guestRoute = label;
        if (!G.running && Net.isConnected()) lobbyStatus.textContent = '✅ Connected • ' + label + '. Waiting for Player 1 to launch…';
      }
    },
    onMessage(d) {
      // The host owns the simulation. Ignore gameplay packets until launch and
      // accept only control messages appropriate for each role.
      const isHost = Net.getRole() === 'host';
      if (d.t === 'start' && !isHost) {
        const lvl = Number.isInteger(d.lvl) && d.lvl >= 1 && d.lvl <= LEVELS.length ? d.lvl : 1;
        setMode(d.mode);
        startLvlSel.value = String(lvl);
        setJoinBusy(false);
        resetGame(true, 2, selectedMode, lvl);
        return;
      }
      if (!G.is2P || !G.running) return;
      if (d.t === 'input' && isHost && G.myId === 1 && Number.isFinite(d.tx)) G.players[2].targetX = Math.max(-0.78, Math.min(0.78, d.tx));
      else if (d.t === 'ult' && isHost && G.myId === 1) activateUlt(2);
      else if (d.t === 'bomb' && isHost && G.myId === 1 && Number.isFinite(d.wx) && Number.isFinite(d.wz)) dropBombStrike(2, d.wx, d.wz);
      else if (d.t === 'taunt' && typeof d.msg === 'string') {
        const other = G.players[G.myId === 1 ? 2 : 1];
        other.taunt = d.msg.slice(0, 80); other.tauntT = 2.0;
      } else if (d.t === 'gameover' && !isHost && G.myId === 2 && Number.isFinite(d.s) && Number.isFinite(d.k) && Number.isFinite(d.w)) {
        G.running = false; showGameOverUI(d.s, d.k, d.w);
      } else if (d.t === 'state' && !isHost && G.myId === 2) {
        if (!Number.isInteger(d.lv) || d.lv < 1 || !d.p1 || !d.p2 ||
            ![d.gt, d.br, d.bl, d.cr, d.sw, d.cn, d.bmS, d.en].every(Array.isArray)) return;
        if (d.lv > G.level) { SoundFX.levelClear(); triggerCutIn(`LEVEL ${d.lv}`, 'NEXT STAGE!'); }
        G.level = d.lv; G.dist = d.ds; G.score = d.s; G.kills = d.k; G.combo = d.c; G.bossSpawnedInLevel = d.bs;
        Object.assign(G.players[1], { x: d.p1.x, count: d.p1.n, wep: d.p1.wp, ult: d.p1.u, ultActive: d.p1.ua, downed: d.p1.dn, bombs: d.p1.bm, buffs: d.p1.bf });
        Object.assign(G.players[2], { count: d.p2.n, wep: d.p2.wp, ult: d.p2.u, ultActive: d.p2.ua, downed: d.p2.dn, bombs: d.p2.bm, buffs: d.p2.bf });
        G.gates = d.gt.map(g => ({ id: g.id, wx: g.x, wz: g.z, w: g.w, op: g.op, val: g.v }));
        G.barricades = d.br.map(b => ({ id: b.id, wx: b.x, wz: b.z, w: b.w, hp: b.hp, maxHp: b.m, reward: b.r, hitFlash: 0 }));
        G.barrels = d.bl.map(b => ({ id: b.id, wx: b.x, wz: b.z, hitFlash: 0 }));
        G.crates = d.cr.map(c => ({ id: c.id, wx: c.x, wz: c.z, reward: c.r, hitFlash: 0 }));
        G.saws = d.sw.map(s => ({ id: s.id, wx: s.x, wz: s.z, rot: s.r }));
        G.coins = d.cn.map(c => ({ id: c.id, wx: c.x, wz: c.z }));
        G.bombStrikes = d.bmS.map(b => ({ wx: b.x, wz: b.z, timer: b.t, maxT: b.m }));
        G.enemies = d.en.map(e => ({ id: e.id, type: e.tp, wx: e.x, wy: e.y, wz: e.z, hp: e.hp, maxHp: e.m, freezeT: e.f, hitFlash: 0, phase: G.scroll * 0.4 }));
      }
    },
    onDisconnected(role, reason, roomStillOpen) {
      // Don't leave either phone playing an unsynchronised two-player match.
      G.running = false;
      $('hud').style.display = 'none';
      modal.classList.remove('hidden');
      gameOverView.style.display = 'none';
      setLaunch(false);
      if (role === 'host' && roomStillOpen) {
        hostView.style.display = 'block'; lobbyView.style.display = 'none';
        hostStatus.textContent = reason + ' Scan this QR again to rejoin and relaunch.';
      } else if (role === 'host') {
        hostView.style.display = 'block'; lobbyView.style.display = 'none';
        hostStatus.textContent = reason;
        hostRetry.style.display = 'flex';
      } else {
        showLobby(reason + ' Tap JOIN to reconnect, or scan a new QR code.');
      }
    }
  });

  // Existing HUD controls.
  $('btnAudio').onclick = () => { $('btnAudio').textContent = SoundFX.toggleMute() ? '🔇' : '🔊'; };
  $('btnBeat').onclick = () => { $('btnBeat').style.opacity = SoundFX.toggleBeat() ? '1' : '0.5'; };
  $('btnVoice').onclick = async () => { $('btnVoice').textContent = (await Net.toggleVoice()) ? '🎙️ LIVE' : '🎙️ OFF'; };
  $('btnMenu').onclick = () => {
    Net.destroy(); setLaunch(false); clearInviteURL(); showLobby();
  };
  $('btnRestart').onclick = () => {
    const startLvl = Number(startLvlSel.value) || 1;
    if (!G.is2P) resetGame(false, 1, 'coop', startLvl);
    else if (!Net.isConnected()) showLobby('Connection lost. Host or join a new room.');
    else if (G.myId === 1) {
      if (Net.send({ t: 'start', mode: G.mode, lvl: startLvl })) resetGame(true, 1, G.mode, startLvl);
      else showLobby('Connection lost. Host or join a new room.');
    } else $('goSub').textContent = 'WAITING FOR HOST TO RESTART…';
  };
  $('btnBackLobby').onclick = () => $('btnMenu').click();

  // Open invitation links as Player 2 without another tap. Audio autoplay on
  // mobile is separate from networking; the first gesture unlocks SFX.
  const autoInvite = inviteFrom(location.href, 'coop');
  if (autoInvite) {
    window.addEventListener('pointerdown', () => safeSound(() => SoundFX.unlock()), { once: true, capture: true });
    startJoin(autoInvite.code, autoInvite.mode);
  } else if (new URLSearchParams(location.search).has('join')) {
    lobbyStatus.textContent = 'Invalid invitation. Scan Player 1’s current QR code.';
  }
  window.addEventListener('pagehide', () => Net.destroy());
  window.addEventListener('pageshow', e => {
    if (e.persisted) {
      // A restored browser snapshot cannot own a live data channel.
      Net.destroy(); setLaunch(false);
      showLobby('Connection closed when the page was left. Host or join again.');
    }
  });

  // =========================================================================
  // 12. MAIN LOOP
  // =========================================================================
  initDeco();
  let lastT = performance.now();
  function loop(now) {
    const dt = Math.min(0.05, (now - lastT) / 1000);
    lastT = now;
    if (G.running) { handleKeyboard(dt); updateSimulation(dt); }
    else {
      G.scroll += dt * 16;
      for (const d of G.hordeDeco) { d.wz -= dt * 12; d.phase += dt * 8; if (d.wz < -2) d.wz = 96; }
    }
    render();
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);
})();
</script>
</body>
</html>
