    function randomText(length, alphabet = ALPHABET) {
      if (!window.crypto?.getRandomValues) throw new Error('This browser cannot create a secure room code.');
      return Array.from(crypto.getRandomValues(new Uint8Array(length)), n => alphabet[n % alphabet.length]).join('');
    }

    // The previous version supplied STUN only, replacing (not extending) the
    // PeerJS 1.5.5 defaults and disabling its relay candidates. Keep the
    // bundled TURN configuration and offer both UDP and TCP when supported.
    function peerOptions(relayOnly = false) {
      const defaults = window.peerjs?.util?.defaultConfig;
      if (!defaults?.iceServers?.length) throw new Error('WebRTC pairing library did not initialize. Reload this page.');
      const iceServers = defaults.iceServers.map(server => ({
        ...server, urls: Array.isArray(server.urls) ? server.urls.slice() : server.urls
      }));
      for (const server of defaults.iceServers) {
        const urls = (Array.isArray(server.urls) ? server.urls : [server.urls])
          .filter(url => typeof url === 'string' && /^turn:/i.test(url) && !url.includes('?'))
          .map(url => url + '?transport=tcp');
        if (urls.length) iceServers.push({ ...server, urls });
      }
      iceServers.push({ urls: 'stun:stun1.l.google.com:19302' });
      return {
        host: '0.peerjs.com', port: 443, path: '/', secure: true, debug: 1,
        config: { ...defaults, iceServers, iceTransportPolicy: relayOnly ? 'relay' : 'all' }
      };
    }

    const valid = (s, p, c) => session === s && (!p || s.peer === p) && (!c || s.conn === c);
    const clearTimer = (s, key) => { clearTimeout(s[key]); s[key] = null; };
    function status(s, text) { if (valid(s)) s.onStatus?.(text); }
    function closeSafely(obj, method = 'close') { try { obj?.[method]?.(); } catch {} }

    function stopVoice(s) {
      if (s.localStream) s.localStream.getTracks().forEach(track => track.stop());
      s.localStream = null;
      if (s.calls) {
        const calls = [...s.calls];
        s.calls.clear();
        calls.forEach(call => closeSafely(call));
      }
      const audio = document.getElementById('remoteAudio');
      if (audio) audio.srcObject = null;
      const button = document.getElementById('btnVoice');
      if (button) button.textContent = '🎙️ OFF';
    }

    function closeConnection(s) {
      clearTimer(s, 'connectTimer');
      clearInterval(s.heartbeat); s.heartbeat = null;
      const old = s.conn;
      s.conn = null; s.ready = false;
      stopVoice(s);
      closeSafely(old);
    }

    function closePeer(s) {
      clearTimer(s, 'signalTimer'); clearTimer(s, 'reconnectTimer');
      const old = s.peer;
      s.peer = null; s.registered = false;
      closeConnection(s);
      closeSafely(old, 'destroy');
    }

    function destroy() {
      const old = session;
      if (!old) return;
      session = null;   // Invalidate callbacks before closing old connections.
      clearTimer(old, 'retryTimer');
      closePeer(old);
    }

    function fail(s, text) {
      if (!valid(s)) return;
      const cb = s.onError;
      const wasReady = s.ready;
      const oldRole = s.role;
      destroy();
      if (wasReady) handlers.onDisconnected?.(oldRole, text, false);
      cb?.(text);
    }

    function errorText(error) {
      switch (error?.type) {
        case 'peer-unavailable': return 'Host room is not reachable. Keep Player 1’s QR screen open.';
        case 'unavailable-id': return 'That room code is already in use.';
        case 'browser-incompatible': return 'This browser does not support WebRTC. Open the game in Safari, Chrome, Edge, or Firefox.';
        case 'network': case 'socket-error': case 'socket-closed': case 'server-error':
          return 'The Internet pairing service could not be reached.';
        default: return 'The direct connection could not be established.';
      }
    }

    function sendRaw(c, message) {
      try {
        if (!c?.open) return false;
        c.send(message);
        return !!c.open;
      } catch { return false; }
    }

    function routeLabel(c) {
      return Promise.resolve().then(() => c?.peerConnection?.getStats?.()).then(stats => {
        if (!stats) return 'WebRTC link';
        let selected = null;
        for (const report of stats.values()) {
          if (report.type === 'transport' && report.selectedCandidatePairId) selected = stats.get(report.selectedCandidatePairId) || selected;
        }
        if (!selected) for (const report of stats.values()) {
          if (report.type === 'candidate-pair' && report.state === 'succeeded' && (report.nominated || report.selected)) { selected = report; break; }
        }
        if (!selected) return 'WebRTC link';
        const local = stats.get(selected.localCandidateId);
        const remote = stats.get(selected.remoteCandidateId);
        return local?.candidateType === 'relay' || remote?.candidateType === 'relay' ? 'TURN relay' : 'direct link';
      }).catch(() => 'WebRTC link');
    }

    function connectionLost(s, c, reason) {
      if (!valid(s, null, c)) return;
      const wasReady = s.ready;
      closeConnection(s);
      if (s.role === 'client') {
        if (wasReady) {
          const oldRole = s.role;
          destroy();
          handlers.onDisconnected?.(oldRole, reason, false);
        } else retryGuest(s, reason);
      } else {
        if (wasReady) handlers.onDisconnected?.('host', reason, !!s.registered);
        status(s, s.registered
          ? (wasReady ? 'Player 2 disconnected. Scan this QR code again to rejoin.' : 'Player 2 could not connect yet. Waiting for their retry…')
          : 'Waiting for the Internet pairing service to reconnect…');
      }
    }

    function installConnection(s, c) {
      if (!valid(s) || !c) { closeSafely(c); return; }
      closeConnection(s);
      s.conn = c;
      let channelOpened = false, welcomed = false;
      let lastSeen = Date.now();
      const ours = () => valid(s, null, c);
      const problem = reason => connectionLost(s, c, reason);
      function markReady() {
        if (!ours() || s.ready) return;
        s.ready = true;
        clearTimer(s, 'connectTimer'); lastSeen = Date.now();
        handlers.onConnected?.(s.role, c.peer);
        routeLabel(c).then(label => { if (ours() && s.ready) handlers.onRoute?.(s.role, label); });
        s.heartbeat = setInterval(() => {
          if (!ours()) return;
          // Keep an idle lobby alive. Backgrounded phones may throttle timers;
          // allow a generous grace period before declaring the link lost.
          if (!document.hidden && Date.now() - lastSeen > 40000) {
            problem('No response from the other phone. Please rejoin.'); return;
          }
          if (!sendRaw(c, { t: '_bc_ping', p: PROTO })) problem('The connection closed.');
        }, 5000);
      }
      function opened() {
        if (!ours() || channelOpened) return;
        channelOpened = true;
        status(s, 'Network link found. Confirming both players…');
        if (s.role === 'client' && !sendRaw(c, { t: '_bc_hello', p: PROTO })) problem('Could not confirm the connection.');
      }
      // Listen for all lifecycle events, including pre-open errors. Do not show
      // "connected" just because the signalling server registered a peer.
      c.on('data', d => {
        if (!ours() || !d || typeof d !== 'object' || typeof d.t !== 'string') return;
        if (d.t.startsWith('_bc_')) {
          if (d.p !== PROTO) return;
          lastSeen = Date.now();
          if (d.t === '_bc_busy' || d.t === '_bc_version') {
            // These aren't transport failures. Don't repeatedly retry a full or incompatible room.
            if (s.role === 'client') fail(s, d.t === '_bc_busy' ? 'This room already has two players. Ask the host to open a new room.' : 'The other phone has an older version. Reload the game on both phones and make a new QR code.');
            return;
          }
          if (d.t === '_bc_hello' && s.role === 'host') {
            welcomed = true;
            if (!sendRaw(c, { t: '_bc_welcome', p: PROTO })) problem('Could not confirm Player 2.');
          } else if (d.t === '_bc_welcome' && s.role === 'client') {
            if (sendRaw(c, { t: '_bc_ready', p: PROTO })) markReady();
            else problem('Could not confirm Player 1.');
          } else if (d.t === '_bc_ready' && s.role === 'host' && welcomed) {
            markReady();
          } else if (d.t === '_bc_ping' && s.ready) {
            sendRaw(c, { t: '_bc_pong', p: PROTO });
          }
          return;
        }
        if (!s.ready) return;   // No game data before the two-way handshake.
        lastSeen = Date.now();
        handlers.onMessage?.(d);
      });
      c.on('open', opened);
      c.on('error', err => { if (ours()) problem(errorText(err)); });
      c.on('iceStateChanged', state => {
        if (ours() && (state === 'failed' || state === 'closed')) problem('The WebRTC connection could not be maintained.');
      });
      c.on('close', () => { if (ours()) problem('The other phone disconnected.'); });
      s.connectTimer = setTimeout(() => {
        if (ours() && !s.ready) problem(channelOpened ? 'The other phone did not confirm the connection.' : 'WebRTC connection timed out.');
      }, s.role === 'host' ? HOST_CONNECT_TIMEOUT : CONNECT_TIMEOUT);
      if (c.open) queueMicrotask(opened);
    }

    function rejectConnection(c, reason) {
      let timer = setTimeout(() => closeSafely(c), 4000);
      const reject = () => {
        clearTimeout(timer);
        sendRaw(c, { t: reason, p: PROTO });
        timer = setTimeout(() => closeSafely(c), 500);
      };
      c.on('open', reject);
      c.on('close', () => clearTimeout(timer));
      c.on('error', () => { clearTimeout(timer); closeSafely(c); });
      if (c.open) reject();
    }

    function incoming(s, p, c) {
      if (!valid(s, p) || !c) { closeSafely(c); return; }
      const m = c.metadata || {};
      if (m.p !== PROTO || typeof m.sid !== 'string' || !/^[A-HJ-NP-Z2-9]{20}$/.test(m.sid) || !Number.isInteger(m.attempt)) {
        rejectConnection(c, '_bc_version'); return;
      }
      if (s.conn) {
        const prior = s.conn.metadata || {};
        // A retry from the SAME joining phone can replace its stalled offer,
        // never an established connection or another player's pending offer.
        if (s.ready || prior.sid !== m.sid || m.attempt <= prior.attempt) {
          rejectConnection(c, '_bc_busy'); return;
        }
      }
      installConnection(s, c);
    }

    function handleCall(s, p, call) {
      if (!valid(s, p) || !s.ready || call.peer !== s.conn?.peer) { closeSafely(call); return; }
      attachCall(s, call);
      // Receiving a call must not request microphone permission during QR join.
      // The local microphone is only enabled using the existing voice button.
      try { call.answer(s.localStream || undefined); } catch { closeSafely(call); }
    }
    function attachCall(s, call) {
      s.calls.add(call);
      call.on('stream', stream => {
        if (!valid(s) || !s.calls.has(call)) return;
        const audio = document.getElementById('remoteAudio');
        if (audio) { audio.srcObject = stream; audio.play().catch(() => {}); }
      });
      call.on('close', () => s.calls.delete(call));
      call.on('error', () => { s.calls.delete(call); closeSafely(call); });
    }

    function watchSignalling(s, p) {
      p.on('call', call => handleCall(s, p, call));
      p.on('disconnected', () => {
        if (!valid(s, p)) return;
        s.registered = false;
        if (!s.ready && s.role === 'client') { retryGuest(s, 'Pairing service disconnected.'); return; }
        if (!s.ready) status(s, 'Reconnecting to the Internet pairing service…');
        if (!s.reconnectTimer) s.reconnectTimer = setTimeout(() => {
          s.reconnectTimer = null;
          if (!valid(s, p) || p.destroyed || !p.disconnected) return;
          try {
            p.reconnect();
            clearTimer(s, 'signalTimer');
            s.signalTimer = setTimeout(() => {
              if (valid(s, p) && !s.registered && !s.ready) fail(s, 'Pairing service disconnected. Host a new room or try again.');
            }, SIGNAL_TIMEOUT);
          } catch { if (!s.ready) fail(s, 'Pairing service disconnected. Try again.'); }
        }, 800);
      });
      p.on('close', () => {
        if (!valid(s, p)) return;
        if (s.role === 'client' && !s.ready) retryGuest(s, 'Pairing service closed.');
        else fail(s, 'Pairing service closed. Please open a new room.');
      });
    }

    function hostRoom(onReady, onStatus, onError) {
      destroy();
      if (!/^https?:$/.test(location.protocol)) { onError('Upload this file to an HTTPS website before hosting a QR room.'); return; }
      const s = session = { role: 'host', code: '', onReady, onStatus, onError, calls: new Set(), attempt: 0, registered: false, announced: false, ready: false };
      function openHost() {
        if (!valid(s)) return;
        closePeer(s);
        s.attempt++;
        try {
          s.code = randomText(8);
          s.announced = false;
          status(s, 'Opening Internet pairing service…');
          const p = s.peer = new Peer(PREFIX + s.code, peerOptions(false));
          s.signalTimer = setTimeout(() => { if (valid(s, p) && !s.registered) fail(s, 'Pairing service did not respond. Check Internet access and try again.'); }, SIGNAL_TIMEOUT);
          p.on('connection', c => incoming(s, p, c));
          watchSignalling(s, p);
          p.on('open', () => {
            if (!valid(s, p)) return;
            s.registered = true;
            clearTimer(s, 'signalTimer'); clearTimer(s, 'reconnectTimer');
            if (!s.announced) { s.announced = true; onReady(s.code); }
            else if (!s.conn) status(s, 'Room ready. Scan the QR code with Player 2’s phone.');
          });
          p.on('error', err => {
            if (!valid(s, p) || s.ready) return;
            if (!s.announced && err?.type === 'unavailable-id' && s.attempt < 4) {
              closePeer(s); s.retryTimer = setTimeout(openHost, 250);
            } else if (s.announced && s.conn) {
              connectionLost(s, s.conn, errorText(err));
            } else fail(s, errorText(err) + ' Try hosting again.');
          });
        } catch (err) { fail(s, err?.message || 'Could not open a room. Try again.'); }
      }
      openHost();
    }

    function retryGuest(s, reason) {
      if (!valid(s) || s.ready || s.retryTimer) return;
      closePeer(s);
      if (s.attempt >= MAX_GUEST_ATTEMPTS) {
        fail(s, reason + ' Check that both phones have Internet, keep the host page open, and tap JOIN to retry. If this Wi-Fi blocks WebRTC, try a different network.');
        return;
      }
      status(s, s.attempt === 1
        ? 'First connection did not open. Retrying through TURN relay…'
        : 'Relay attempt did not open. Retrying with a fresh connection…');
      s.retryTimer = setTimeout(() => { s.retryTimer = null; openGuest(s); }, 500);
    }

    function openGuest(s) {
      if (!valid(s)) return;
      s.attempt++;
      const relayOnly = s.attempt === 2;
      try {
        status(s, 'Finding room ' + s.code + ' • attempt ' + s.attempt + '/' + MAX_GUEST_ATTEMPTS + '…');
        const p = s.peer = new Peer('BC2G-' + s.sid + '-' + s.attempt, peerOptions(relayOnly));
        s.signalTimer = setTimeout(() => {
          if (valid(s, p) && !s.registered) retryGuest(s, 'The Internet pairing service timed out.');
        }, SIGNAL_TIMEOUT);
        watchSignalling(s, p);
        p.on('open', () => {
          if (!valid(s, p)) return;
          s.registered = true; clearTimer(s, 'signalTimer'); clearTimer(s, 'reconnectTimer');
          if (s.conn) return;
          status(s, relayOnly ? 'Connecting via TURN relay…' : 'Room found. Establishing direct or relayed link…');
          try {
            const c = p.connect(PREFIX + s.code, {
              serialization: 'binary', reliable: true,
              metadata: { p: PROTO, sid: s.sid, attempt: s.attempt }
            });
            if (!c) retryGuest(s, 'The room could not be contacted.');
            else installConnection(s, c);
          } catch { retryGuest(s, 'Could not open the link.'); }
        });
        p.on('connection', c => closeSafely(c));
        p.on('error', err => {
          if (!valid(s, p) || s.ready) return;
          if (err?.type === 'browser-incompatible' || err?.type === 'invalid-id') fail(s, errorText(err));
          else retryGuest(s, errorText(err));
        });
      } catch (err) { fail(s, err?.message || 'Could not join the room.'); }
    }
    function joinRoom(code, onStatus, onError) {
      destroy();
      if (!ROOM_RE.test(code)) { onError('Enter a valid room code or paste the host’s invitation link.'); return; }
      try {
        const s = session = { role: 'client', code, sid: randomText(20), onStatus, onError, calls: new Set(), attempt: 0, registered: false, ready: false };
        openGuest(s);
      } catch (err) { onError(err?.message || 'Could not join the room.'); }
    }

    async function toggleVoice() {
      const s = session;
      if (!s?.ready || !s.peer || !s.conn?.open) return false;
      if (s.localStream) { stopVoice(s); return false; }
      try {
        if (!navigator.mediaDevices?.getUserMedia) throw new Error('Unavailable');
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        if (!valid(s) || !s.ready) { stream.getTracks().forEach(track => track.stop()); return false; }
        s.localStream = stream;
        const call = s.peer.call(s.conn.peer, stream);
        if (!call) throw new Error('Voice call failed');
        attachCall(s, call);
        return true;
      } catch {
        if (valid(s)) {
          stopVoice(s);
          alert('Mic unavailable, or voice connection could not be established.');
        }
        return false;
      }
    }

    return {
      hostRoom, joinRoom, destroy, toggleVoice,
      send(message) {
        const s = session, c = s?.conn;
        if (!s?.ready || !c?.open) return false;
        // Latest-state messages are disposable when a relayed network is
        // congested; prevent outdated snapshots from piling up in the buffer.
        if ((message.t === 'state' || message.t === 'input') &&
            ((c.bufferSize || 0) > 3 || (c.dataChannel?.bufferedAmount || 0) > 65536)) return false;
        return sendRaw(c, message);
      },
      isConnected: () => !!(session?.ready && session.conn?.open),
      getRole: () => session?.role || 'solo',
      isHosting: () => session?.role === 'host' && session.registered,
      setHandlers: cb => { handlers = cb; }
    };
  })();

  // =========================================================================
  // 4. PERSPECTIVE MATH & GAME STATE
  // =========================================================================
  const canvas = document.getElementById('gameCanvas');
  const ctx = canvas.getContext('2d');
  let W = 0, H = 0, DPR = 1;

  function resize() {
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = window.innerWidth;
    H = window.innerHeight;
    canvas.width = Math.floor(W * DPR);
    canvas.height = Math.floor(H * DPR);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  }
  window.addEventListener('resize', resize);
  resize();

  const CAM_Z = 14;
  function proj(wx, wy, wz) {
    const z = Math.max(-4, wz);
    const scale = CAM_Z / (z + CAM_Z);
    const horizonY = H * 0.19;
    const groundY = H * 0.84;
    const screenY = horizonY + (groundY - horizonY) * scale - wy * scale * (H * 0.42);
    const centerX = W * 0.54;
    const roadHalfW = Math.min(W * 0.44, 240);
    return { x: centerX + wx * roadHalfW * scale, y: screenY, s: scale };
  }

  function unproj(sx, sy) {
    const horizonY = H * 0.19;
    const groundY = H * 0.84;
    const scale = Math.max(0.14, Math.min(1.05, (sy - horizonY) / (groundY - horizonY)));
    const wz = Math.max(4, Math.min(92, CAM_Z / scale - CAM_Z));
    const centerX = W * 0.54;
    const roadHalfW = Math.min(W * 0.44, 240);
    const wx = Math.max(-0.85, Math.min(0.85, (sx - centerX) / (roadHalfW * scale)));
    return { wx, wz };
  }

